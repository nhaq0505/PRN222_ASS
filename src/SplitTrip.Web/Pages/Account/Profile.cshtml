@page
@model SplitTrip.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Hồ sơ & Ngân hàng VietQR";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Hồ sơ cá nhân & Ngân hàng VietQR</h1>
        <p class="text-muted small mb-0">
            Cấu hình tài khoản ngân hàng Napas 247 để bạn bè quét mã VietQR thanh toán công nợ tức thì sau chuyến đi.
        </p>
    </div>
    <a asp-page="/Index" class="btn st-btn-ghost btn-sm">← Về danh sách chuyến đi</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert st-alert-danger mb-4" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="st-card p-4">
            <h2 class="h6 fw-bold mb-3">Thông tin tài khoản & Thụ hưởng</h2>

            <form method="post" novalidate>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold small">Email đăng nhập</label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Input.FullName" class="form-label fw-semibold small">Họ và tên hiển thị</label>
                        <input asp-for="Input.FullName" class="form-control" id="stFullNameInput" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.AvatarUrl" class="form-label fw-semibold small">Ảnh đại diện URL (tùy chọn)</label>
                        <input asp-for="Input.AvatarUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="Input.AvatarUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <hr class="my-2" />
                        <div class="fw-bold small text-uppercase text-secondary mb-1" style="letter-spacing: 0.05em;">
                            Cấu hình nhận tiền Napas VietQR
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.SelectedBankBin" class="form-label fw-semibold small">Ngân hàng thụ hưởng (Napas BIN)</label>
                        <select asp-for="Input.SelectedBankBin" class="form-select" id="stBankBinSelect">
                            <option value="">-- Chọn ngân hàng nhận chuyển khoản --</option>
                            @foreach (var bank in Model.Banks)
                            {
                                <option value="@bank.BankBin" data-code="@bank.BankCode" data-short="@bank.ShortName">
                                    @bank.ShortName (@bank.BankCode &middot; BIN @bank.BankBin) — @bank.FullName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Input.BankAccountNumber" class="form-label fw-semibold small">Số tài khoản (STK)</label>
                        <input asp-for="Input.BankAccountNumber" class="form-control font-monospace" id="stAccountNoInput" placeholder="VD: 0123456789" />
                        <span asp-validation-for="Input.BankAccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Input.BankAccountHolder" class="form-label fw-semibold small">Chủ tài khoản (IN HOA KHÔNG DẤU)</label>
                        <input asp-for="Input.BankAccountHolder" class="form-control text-uppercase" id="stAccountHolderInput" placeholder="VD: NGUYEN VAN AN" />
                        <span asp-validation-for="Input.BankAccountHolder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn st-btn-primary px-4">Lưu hồ sơ & VietQR</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="st-card p-4 h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 fw-bold mb-0">Xem trước mã VietQR trực tiếp</h2>
                <span class="badge rounded-pill text-bg-success">Napas 247</span>
            </div>

            <div id="stQrEmptyState" class="border rounded-4 p-4 text-center my-auto bg-light">
                <div class="fw-semibold text-dark mb-1">Chưa đủ thông tin tạo mã QR</div>
                <p class="small text-muted mb-0">
                    Hãy chọn ngân hàng và nhập số tài khoản ở khung bên trái để xem trước mã thanh toán VietQR mẫu (50.000đ).
                </p>
            </div>

            <div id="stQrPreviewWrap" class="text-center d-none">
                <div class="p-3 border rounded-4 bg-white d-inline-block shadow-sm mb-3">
                    <img id="stQrPreviewImg" src="" alt="Mã VietQR xem trước" class="img-fluid rounded-3" style="max-width: 250px;" />
                </div>
                <div class="small text-muted">
                    Mã mẫu thử nghiệm <strong class="text-dark">50.000đ</strong> &middot; Nội dung: <code id="stQrPreviewNote">SPLITTRIP DEMO</code>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const bankSelect = document.getElementById("stBankBinSelect");
            const stkInput = document.getElementById("stAccountNoInput");
            const holderInput = document.getElementById("stAccountHolderInput");
            const emptyState = document.getElementById("stQrEmptyState");
            const previewWrap = document.getElementById("stQrPreviewWrap");
            const previewImg = document.getElementById("stQrPreviewImg");

            function stripVietnamese(str) {
                return (str || "")
                    .replace(/đ/g, "d")
                    .replace(/Đ/g, "D")
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toUpperCase()
                    .trim();
            }

            function refreshPreview() {
                const bin = (bankSelect && bankSelect.value || "").trim();
                const stk = (stkInput && stkInput.value || "").replace(/\s+/g, "");
                const holder = stripVietnamese(holderInput && holderInput.value || "");

                if (!bin || !stk) {
                    emptyState.classList.remove("d-none");
                    previewWrap.classList.add("d-none");
                    return;
                }

                const url = "https://img.vietqr.io/image/"
                    + encodeURIComponent(bin) + "-" + encodeURIComponent(stk) + "-compact2.png"
                    + "?amount=50000&addInfo=" + encodeURIComponent("SPLITTRIP DEMO")
                    + (holder ? "&accountName=" + encodeURIComponent(holder) : "");

                previewImg.src = url;
                emptyState.classList.add("d-none");
                previewWrap.classList.remove("d-none");
            }

            if (bankSelect) bankSelect.addEventListener("change", refreshPreview);
            if (stkInput) stkInput.addEventListener("input", refreshPreview);
            if (holderInput) holderInput.addEventListener("input", refreshPreview);
            refreshPreview();
        })();
    </script>
}
