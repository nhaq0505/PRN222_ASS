@page
@model SplitTrip.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="st-card p-4 p-sm-5 text-center">
            <div class="badge rounded-pill text-bg-danger mb-3 px-3 py-2">403 Forbidden</div>
            <h1 class="h4 fw-bold mb-2">Bạn không có quyền truy cập trang này</h1>
            <p class="text-muted small mb-4">
                Khu vực này yêu cầu quyền Quản trị viên hệ thống hoặc quyền thành viên tương ứng của chuyến đi.
            </p>
            <a asp-page="/Index" class="btn st-btn-primary">Quay về trang chủ</a>
        </div>
    </div>
</div>
