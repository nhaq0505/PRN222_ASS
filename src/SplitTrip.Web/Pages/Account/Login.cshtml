@page
@model SplitTrip.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="st-card p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="st-brand-mark mx-auto mb-3">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <polyline points="10 17 15 12 10 7" />
                        <line x1="15" y1="12" x2="3" y2="12" />
                    </svg>
                </div>
                <h1 class="h4 fw-bold mb-1">Chào mừng trở lại SplitTrip</h1>
                <p class="text-muted small mb-0">Đăng nhập để quản lý lịch trình nhóm, chi tiêu & tất toán VietQR</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert st-alert-danger py-2 px-3 small mb-3" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold small">Email</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="ban@example.com" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold small">Mật khẩu</label>
                    <input asp-for="Input.Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label small text-secondary">
                        Duy trì đăng nhập trên thiết bị này
                    </label>
                </div>

                <button type="submit" id="loginSubmitBtn" class="btn st-btn-primary w-100 py-2">
                    Đăng nhập
                </button>
            </form>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-secondary">Điền nhanh tài khoản Demo</span>
                    <span class="badge rounded-pill text-bg-light border text-secondary fw-normal">1-click</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button"
                            class="btn btn-sm st-btn-ghost py-1 px-2 small demo-quick-fill"
                            data-demo-email="an@splittrip.vn"
                            data-demo-password="User@123"
                            title="Trưởng đoàn chuyến Đà Lạt Săn Mây 3N2Đ">
                        <span class="fw-semibold">An (Owner)</span> · <span class="text-muted">an@splittrip.vn</span>
                    </button>
                    <button type="button"
                            class="btn btn-sm st-btn-ghost py-1 px-2 small demo-quick-fill"
                            data-demo-email="binh@splittrip.vn"
                            data-demo-password="User@123"
                            title="Thành viên chuyến Đà Lạt Săn Mây 3N2Đ">
                        <span class="fw-semibold">Bình</span> · <span class="text-muted">binh@splittrip.vn</span>
                    </button>
                    <button type="button"
                            class="btn btn-sm st-btn-ghost py-1 px-2 small demo-quick-fill"
                            data-demo-email="admin@splittrip.vn"
                            data-demo-password="Admin@123"
                            title="Quản trị viên hệ thống (/Admin)">
                        <span class="st-dot-admin"></span><span class="fw-semibold">Admin</span> · <span class="text-muted">admin@splittrip.vn</span>
                    </button>
                </div>
                <div class="text-muted mt-2" style="font-size: 0.76rem;">
                    Thành viên nhóm khác: <code>chi@splittrip.vn</code>, <code>dung@splittrip.vn</code> (mật khẩu <code>User@123</code>)
                </div>
            </div>

            <hr class="my-4" />
            <div class="text-center small text-secondary">
                Chưa có tài khoản?
                <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl" class="st-link-teal text-decoration-none">
                    Tạo tài khoản miễn phí
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.demo-quick-fill').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var emailInput = document.getElementById('Input_Email');
                var passwordInput = document.getElementById('Input_Password');
                var submitBtn = document.getElementById('loginSubmitBtn');
                if (emailInput && passwordInput) {
                    emailInput.value = btn.getAttribute('data-demo-email') || '';
                    passwordInput.value = btn.getAttribute('data-demo-password') || '';
                    emailInput.dispatchEvent(new Event('input', { bubbles: true }));
                    passwordInput.dispatchEvent(new Event('input', { bubbles: true }));
                    emailInput.dispatchEvent(new Event('change', { bubbles: true }));
                    passwordInput.dispatchEvent(new Event('change', { bubbles: true }));
                }
                if (submitBtn) {
                    submitBtn.focus();
                }
            });
        });
    </script>
}
