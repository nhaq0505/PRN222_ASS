@page
@model SplitTrip.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Quản trị hệ thống & Báo cáo phân tích";
    var d = Model.Dashboard;
    var kpi = d.Kpis;
    var ss = d.SettlementSummary;
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
    var last30Start = today.AddDays(-30).ToString("yyyy-MM-dd");
    var todayIso = today.ToString("yyyy-MM-dd");
    var yearStartIso = new DateOnly(today.Year, 1, 1).ToString("yyyy-MM-dd");
    var yearEndIso = new DateOnly(today.Year, 12, 31).ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/css/settlement.css" asp-append-version="true" />
}

<!-- Admin Hero & Date-Range Filter -->
<div class="st-hero p-4 mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge rounded-pill text-bg-warning">System Administrator</span>
                <span class="text-muted small">
                    Cập nhật lúc @d.GeneratedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                </span>
            </div>
            <h1 class="h3 fw-bold mb-1">Bảng điều khiển Quản trị &amp; Báo cáo Tài chính</h1>
            <p class="text-secondary small mb-0">
                Tổng hợp khối lượng chi tiêu đã xác thực (loại trừ hóa đơn nháp), hiệu suất rút gọn nợ chéo Min-Cash-Flow và báo cáo chuyến đi sắp xếp giảm dần.
            </p>
        </div>

        <form method="get" class="bg-white border rounded-4 p-3 shadow-sm">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-sm-auto">
                    <label for="startDateInput" class="form-label small fw-semibold text-secondary mb-1">Từ ngày (StartDate)</label>
                    <input type="date" id="startDateInput" name="StartDate"
                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-auto">
                    <label for="endDateInput" class="form-label small fw-semibold text-secondary mb-1">Đến ngày (EndDate)</label>
                    <input type="date" id="endDateInput" name="EndDate"
                           value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-auto d-flex gap-2">
                    <button type="submit" class="btn btn-sm st-btn-primary">
                        Lọc báo cáo
                    </button>
                    @if (Model.StartDate.HasValue || Model.EndDate.HasValue)
                    {
                        <a asp-page="/Admin/Index" class="btn btn-sm st-btn-ghost">Xóa lọc</a>
                    }
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top small">
                <span class="text-muted">Chọn nhanh:</span>
                <a asp-page="/Admin/Index" class="text-decoration-none st-link-teal">Toàn thời gian</a>
                <span class="text-muted">&middot;</span>
                <a href="/Admin/Index?StartDate=@last30Start&EndDate=@todayIso" class="text-decoration-none st-link-teal">30 ngày gần nhất</a>
                <span class="text-muted">&middot;</span>
                <a href="/Admin/Index?StartDate=@yearStartIso&EndDate=@yearEndIso" class="text-decoration-none st-link-teal">Năm @today.Year</a>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.FilterError))
{
    <div class="alert st-alert-danger mb-4" role="alert">
        <strong>Bộ lọc thời gian không hợp lệ:</strong> @Model.FilterError
    </div>
}

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="st-card p-4 h-100">
            <div class="small text-muted mb-1">Tổng thành viên đăng ký</div>
            <div class="h3 fw-bold mb-1">@kpi.TotalRegisteredUsers.ToString("N0")</div>
            <div class="small text-secondary">
                <span class="text-success fw-semibold">+@kpi.NewUsersInRange</span> tài khoản tạo trong kỳ lọc
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="st-card p-4 h-100">
            <div class="small text-muted mb-1">Chuyến đi trong kỳ báo cáo</div>
            <div class="h3 fw-bold mb-2">@kpi.TotalTrips.ToString("N0") chuyến</div>
            <div class="d-flex flex-wrap gap-1 small">
                <span class="badge rounded-pill text-bg-info-subtle text-info-emphasis border">Planning: @kpi.PlanningTrips</span>
                <span class="badge rounded-pill text-bg-success-subtle text-success border">Ongoing: @kpi.OngoingTrips</span>
                <span class="badge rounded-pill text-bg-warning-subtle text-warning-emphasis border">Settling: @kpi.SettlingTrips</span>
                <span class="badge rounded-pill bg-light text-secondary border">Completed: @kpi.CompletedTrips</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="st-card p-4 h-100">
            <div class="small text-muted mb-1">Tổng khối lượng chi tiêu xác thực</div>
            <div class="h3 fw-bold text-dark mb-1">@kpi.TotalFinalizedVolumeVnd.ToString("N0")đ</div>
            <div class="small text-secondary">
                Từ <strong>@kpi.FinalizedExpenseCount</strong> khoản chi hợp lệ (không tính nháp OCR)
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="st-card p-4 h-100">
            <div class="small text-muted mb-1">Tất toán VietQR (Đã nhận / Còn chờ)</div>
            <div class="h4 fw-bold text-success mb-1">@kpi.ConfirmedSettledVnd.ToString("N0")đ</div>
            <div class="small text-secondary">
                Đang chờ / cần tất toán: <strong class="text-danger">@kpi.PendingSettlementVnd.ToString("N0")đ</strong>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="st-card p-4 h-100">
            <div class="small text-muted mb-1">Mức độ ứng dụng Gemini AI</div>
            <div class="h3 fw-bold mb-1">@kpi.AiScannedReceiptsCount hóa đơn OCR</div>
            <div class="small text-secondary">
                Lịch trình AI gợi ý: <strong>@kpi.AiSuggestedStopsCount / @kpi.TotalItineraryStops</strong> điểm dừng
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="st-card p-4 h-100">
            <div class="small text-muted mb-1">Hiệu suất rút gọn nợ Min-Cash-Flow</div>
            <div class="h3 fw-bold text-teal mb-1" style="color: var(--st-primary);">
                -@kpi.SimplificationEfficiencyPercent% giao dịch
            </div>
            <div class="small text-secondary">
                Triệt tiêu <strong>@kpi.TotalEliminatedTransfers</strong> trên @kpi.TotalRawSplitObligations nghĩa vụ chéo (còn @kpi.TotalSimplifiedTransfers lệnh)
            </div>
        </div>
    </div>
</div>

<!-- Category Breakdown & Settlement Status Breakdown -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-7">
        <div class="st-card h-100">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h5 fw-bold mb-1">Cơ cấu chi tiêu theo danh mục</h2>
                    <p class="small text-muted mb-0">Sắp xếp giảm dần theo tổng giá trị VND đã xác thực</p>
                </div>
            </div>
            <div class="p-4">
                @if (d.CategoryBreakdown.Count == 0)
                {
                    <div class="text-center text-muted small py-4">Chưa có dữ liệu chi tiêu trong khoảng thời gian này.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var cat in d.CategoryBreakdown)
                        {
                            <div>
                                <div class="d-flex justify-content-between align-items-center small mb-1">
                                    <span class="fw-semibold text-dark">@cat.CategoryLabel <span class="text-muted fw-normal">(@cat.ExpenseCount khoản)</span></span>
                                    <span class="font-monospace fw-bold">@cat.TotalAmountVnd.ToString("N0")đ (@cat.SharePercentage%)</span>
                                </div>
                                <div class="st-ledger-bar-track">
                                    <div class="st-ledger-bar-pos" style="width: @(Math.Max(4, (int)Math.Round(cat.SharePercentage)))%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="st-card h-100">
            <div class="p-4 border-bottom">
                <h2 class="h5 fw-bold mb-1">Trạng thái giao dịch Tất toán 2 bước</h2>
                <p class="small text-muted mb-0">Phân bổ các lệnh VietQR trên toàn nền tảng</p>
            </div>
            <div class="p-4 d-flex flex-column gap-3">
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-success-subtle border border-success-subtle">
                    <div>
                        <div class="fw-semibold text-success-emphasis">Đã xác nhận hoàn tất (Confirmed)</div>
                        <div class="small text-muted">@ss.ConfirmedCount giao dịch</div>
                    </div>
                    <div class="fw-bold font-monospace text-success">@ss.ConfirmedAmountVnd.ToString("N0")đ</div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-warning-subtle border border-warning-subtle">
                    <div>
                        <div class="fw-semibold text-warning-emphasis">Đã báo chuyển · Chờ chủ nợ duyệt</div>
                        <div class="small text-muted">@ss.MarkedPaidCount giao dịch</div>
                    </div>
                    <div class="fw-bold font-monospace text-dark">@ss.MarkedPaidAmountVnd.ToString("N0")đ</div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light border">
                    <div>
                        <div class="fw-semibold text-dark">Chờ người nợ chuyển khoản (Pending)</div>
                        <div class="small text-muted">@ss.PendingCount giao dịch</div>
                    </div>
                    <div class="fw-bold font-monospace text-secondary">@ss.PendingAmountVnd.ToString("N0")đ</div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-danger-subtle border border-danger-subtle">
                    <div>
                        <div class="fw-semibold text-danger-emphasis">Báo chưa nhận / Khiếu nại (Disputed)</div>
                        <div class="small text-muted">@ss.DisputedCount giao dịch</div>
                    </div>
                    <div class="fw-bold font-monospace text-danger">@ss.DisputedAmountVnd.ToString("N0")đ</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Descending Date-Range Trip & Financial Volume Report Table -->
<div class="st-card overflow-hidden mb-4">
    <div class="p-4 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
        <div>
            <h2 class="h5 fw-bold mb-1">Báo cáo Chuyến đi &amp; Doanh số Chi tiêu (Sắp xếp Giảm dần ↓)</h2>
            <p class="small text-muted mb-0">
                @if (d.StartDate.HasValue || d.EndDate.HasValue)
                {
                    <span>
                        Đang lọc từ <strong>@(d.StartDate?.ToString("dd/MM/yyyy") ?? "đầu kỳ")</strong> đến <strong>@(d.EndDate?.ToString("dd/MM/yyyy") ?? "hiện tại")</strong>
                    </span>
                }
                else
                {
                    <span>Hiển thị toàn bộ chuyến đi trên hệ thống, sắp xếp giảm dần theo Tổng chi tiêu và Ngày tạo.</span>
                }
            </p>
        </div>
        <span class="badge bg-dark rounded-pill">@d.TripReportRows.Count chuyến đi</span>
    </div>

    @if (d.TripReportRows.Count == 0)
    {
        <div class="p-5 text-center text-muted">
            Không có chuyến đi nào khớp với khoảng thời gian đã chọn.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light small text-uppercase text-secondary">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Chuyến đi &amp; Trưởng đoàn</th>
                        <th>Lịch trình &amp; Trạng thái</th>
                        <th class="text-center">Thành viên</th>
                        <th class="text-center">Khoản chi / OCR</th>
                        <th class="text-end">Tổng chi tiêu ↓</th>
                        <th class="text-end">Đã tất toán</th>
                        <th class="text-end">Còn chờ</th>
                        <th class="text-center">Min-Cash-Flow</th>
                        <th class="text-end pe-4">Kiểm tra</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < d.TripReportRows.Count; i++)
                    {
                        var row = d.TripReportRows[i];
                        var statusMeta = IndexModel.DescribeTripStatus(row.Status);
                        <tr>
                            <td class="ps-4 text-muted small fw-semibold">@(i + 1)</td>
                            <td class="py-3">
                                <div class="fw-semibold text-dark">@row.TripName</div>
                                <div class="small text-muted">
                                    📍 @row.Destination &middot; Trưởng đoàn: @row.OwnerName &middot; <span class="font-monospace">@row.InviteCode</span>
                                </div>
                            </td>
                            <td>
                                <span class="st-status-pill @statusMeta.Css mb-1">@statusMeta.Label</span>
                                <div class="small text-muted">
                                    @row.StartDate.ToString("dd/MM/yyyy") &rarr; @row.EndDate.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td class="text-center fw-semibold">@row.ActiveMemberCount</td>
                            <td class="text-center small">
                                <span class="fw-semibold text-dark">@row.FinalizedExpenseCount</span>
                                @if (row.AiReceiptCount > 0)
                                {
                                    <span class="badge text-bg-info ms-1">@row.AiReceiptCount AI</span>
                                }
                            </td>
                            <td class="text-end font-monospace fw-bold text-dark">@row.TotalSpendVnd.ToString("N0")đ</td>
                            <td class="text-end font-monospace small text-success fw-semibold">@row.ConfirmedSettledVnd.ToString("N0")đ</td>
                            <td class="text-end font-monospace small @(row.PendingSettlementVnd > 0m ? "text-danger fw-semibold" : "text-muted")">
                                @row.PendingSettlementVnd.ToString("N0")đ
                            </td>
                            <td class="text-center small">
                                @if (row.EliminatedTransfersCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-success-subtle text-success border border-success-subtle">
                                        @row.RawObligationCount &rarr; @row.SimplifiedTransferCount (−@row.EliminatedTransfersCount)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">@row.SimplifiedTransferCount lệnh</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="/Trips/Details" asp-route-id="@row.TripId" class="btn btn-outline-secondary">
                                        Tổng quan
                                    </a>
                                    <a href="/Trips/Settlement?tripId=@row.TripId" class="btn btn-outline-primary">
                                        Sổ cái
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Recent Platform Activity -->
<div class="st-card overflow-hidden">
    <div class="p-4 border-bottom">
        <h2 class="h5 fw-bold mb-1">Hoạt động gần đây trên nền tảng</h2>
        <p class="small text-muted mb-0">Dòng sự kiện thời gian thực từ các đoàn du lịch đang hoạt động</p>
    </div>

    @if (d.RecentActivities.Count == 0)
    {
        <div class="p-4 text-center text-muted small">Chưa ghi nhận hoạt động nào.</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var act in d.RecentActivities)
            {
                <div class="list-group-item px-4 py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div class="d-flex align-items-start gap-3">
                        <span class="badge rounded-pill @act.BadgeCss mt-1">@act.BadgeLabel</span>
                        <div>
                            <div class="fw-semibold text-dark small">@act.Title</div>
                            <div class="small text-muted">@act.Subtitle</div>
                        </div>
                    </div>
                    <div class="text-sm-end">
                        @if (act.AmountVnd.HasValue)
                        {
                            <div class="font-monospace fw-bold small text-dark">@act.AmountVnd.Value.ToString("N0")đ</div>
                        }
                        <div class="small text-muted">@act.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            }
        </div>
    }
</div>
