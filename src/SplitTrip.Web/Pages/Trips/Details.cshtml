@page
@model SplitTrip.Web.Pages.Trips.DetailsModel
@{
    ViewData["Title"] = Model.Trip.Name;
    var statusMeta = DetailsModel.DescribeStatus(Model.Trip.Status);
    var totalSpend = Model.Trip.MemberBalances.Sum(b => b.TotalPaid);
    var ledgerSum = Model.Trip.MemberBalances.Sum(b => b.NetBalance);
    var allBalancesZero = Model.Trip.MemberBalances.All(b => b.NetBalance == 0m);
}

<div id="stTripWorkspace" data-trip-id="@Model.Trip.Id">
    <!-- Trip Header -->
    <div class="st-card p-4 mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span id="stTripStatusBadge" class="st-status-pill @statusMeta.Css">@statusMeta.Label</span>
                    <span class="text-muted small">
                        📍 @Model.Trip.Destination &middot; @Model.Trip.StartDate.ToString("dd/MM/yyyy") &rarr; @Model.Trip.EndDate.ToString("dd/MM/yyyy") (@Model.Trip.DayCount ngày)
                    </span>
                </div>
                <h1 class="h3 fw-bold mb-1">@Model.Trip.Name</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Trip.Description))
                {
                    <p class="text-secondary small mb-0">@Model.Trip.Description</p>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="st-invite-box" title="Mã mời tham gia chuyến đi">
                    <span class="text-muted small fw-normal" style="letter-spacing:0;">Mã mời:</span>
                    <span id="stInviteCodeText">@Model.Trip.InviteCode</span>
                    <button type="button" id="stCopyInviteBtn" class="btn btn-sm btn-light border py-0 px-2 small"
                            data-code="@Model.Trip.InviteCode">
                        Sao chép
                    </button>
                </div>
            </div>
        </div>

        <!-- Owner Lifecycle Controls -->
        @if (Model.IsOwner && Model.Trip.Status != TripStatus.Completed)
        {
            <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="small text-muted">
                    <strong class="text-dark">Điều khiển vòng đời chuyến đi (Trưởng đoàn):</strong>
                    <span>Planning &rarr; Ongoing &rarr; Settling &rarr; Completed</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Trip.Status == TripStatus.Planning)
                    {
                        <form method="post" asp-page-handler="TransitionStatus" asp-route-id="@Model.Trip.Id" class="m-0">
                            <input type="hidden" name="targetStatus" value="@TripStatus.Ongoing" />
                            <button type="submit" class="btn btn-sm st-btn-primary">
                                Bắt đầu chuyến đi (Ongoing) →
                            </button>
                        </form>
                    }
                    else if (Model.Trip.Status == TripStatus.Ongoing)
                    {
                        <form method="post" asp-page-handler="TransitionStatus" asp-route-id="@Model.Trip.Id" class="m-0">
                            <input type="hidden" name="targetStatus" value="@TripStatus.Settling" />
                            <button type="submit" class="btn btn-sm btn-warning fw-semibold">
                                Khóa chi tiêu &amp; Chuyển sang Tất toán →
                            </button>
                        </form>
                    }
                    else if (Model.Trip.Status == TripStatus.Settling)
                    {
                        <form method="post" asp-page-handler="TransitionStatus" asp-route-id="@Model.Trip.Id" class="m-0">
                            <input type="hidden" name="targetStatus" value="@TripStatus.Ongoing" />
                            <button type="submit" class="btn btn-sm st-btn-ghost">
                                ↺ Mở lại thêm chi tiêu (Ongoing)
                            </button>
                        </form>
                        <form method="post" asp-page-handler="TransitionStatus" asp-route-id="@Model.Trip.Id" class="m-0">
                            <input type="hidden" name="targetStatus" value="@TripStatus.Completed" />
                            <button type="submit" class="btn btn-sm btn-success fw-semibold"
                                    @(allBalancesZero ? "" : "disabled")
                                    title="@(allBalancesZero ? "Hoàn tất và đóng chuyến đi" : "Cần tất toán hết số dư công nợ về 0đ trước khi hoàn tất")">
                                ✓ Xác nhận Hoàn tất (Completed)
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Sub-Navigation Workspace Tabs -->
    <nav class="st-trip-tabs mb-4" aria-label="Điều hướng không gian chuyến đi">
        <a class="st-trip-tab active" asp-page="/Trips/Details" asp-route-id="@Model.Trip.Id">
            Tổng quan &amp; Thành viên
        </a>
        <a class="st-trip-tab" href="/Trips/Itinerary?tripId=@Model.Trip.Id">
            Lịch trình &amp; AI Planner
        </a>
        <a class="st-trip-tab" href="/Trips/Expenses?tripId=@Model.Trip.Id">
            Chi tiêu &amp; Quét hóa đơn
        </a>
        <a class="st-trip-tab" href="/Trips/Settlement?tripId=@Model.Trip.Id">
            Tất toán VietQR
        </a>
    </nav>

    <!-- Summary KPI Strip -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Thành viên đang tham gia</div>
                <div class="h4 fw-bold mb-0" id="stActiveMemberCount">@Model.Trip.MemberBalances.Count(m => m.IsActive) người</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Ngân sách dự kiến / người</div>
                <div class="h4 fw-bold mb-0">@Model.Trip.EstimatedBudgetPerPerson.ToString("N0")đ</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Tổng chi tiêu đã xác thực</div>
                <div class="h4 fw-bold mb-0 text-dark" id="stTotalSpendKpi">@totalSpend.ToString("N0")đ</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Kiểm chứng sổ cái Zero-Sum</div>
                <div class="h5 fw-bold mb-0 @(ledgerSum == 0m ? "text-success" : "text-danger")" id="stZeroSumBadge">
                    ∑ Net = @ledgerSum.ToString("N0")đ
                </div>
            </div>
        </div>
    </div>

    <!-- Members & NetBalance Ledger Table -->
    <div class="st-card overflow-hidden">
        <div class="p-4 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <div>
                <h2 class="h5 fw-bold mb-1">Thành viên &amp; Sổ cái số dư ròng (NetBalance)</h2>
                <p class="small text-muted mb-0">
                    Thành viên chỉ có thể rời hoặc được xóa khỏi đoàn khi số dư công nợ ròng bằng <strong>0đ</strong>.
                </p>
            </div>
            <span class="badge bg-light text-secondary border">
                <span class="text-success me-1">●</span> Đồng bộ SignalR trực tiếp
            </span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light small text-uppercase text-secondary">
                    <tr>
                        <th class="ps-4">Thành viên</th>
                        <th>Ngân hàng VietQR</th>
                        <th class="text-end">Đã ứng chi</th>
                        <th class="text-end">Phần phải trả</th>
                        <th class="text-end">Đã tất toán</th>
                        <th class="text-end">Số dư ròng (Net)</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="stMembersTableBody">
                    @foreach (var member in Model.Trip.MemberBalances)
                    {
                        var initials = string.Join("", member.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(s => char.ToUpperInvariant(s[0])));
                        if (string.IsNullOrWhiteSpace(initials)) initials = "TV";

                        var hasBank = !string.IsNullOrWhiteSpace(member.BankBin ?? member.BankCode)
                                      && !string.IsNullOrWhiteSpace(member.BankAccountNumber);
                        var netSettled = member.SettlementsPaid - member.SettlementsReceived;
                        var balanceClass = member.NetBalance > 0m ? "st-balance-pos"
                            : member.NetBalance < 0m ? "st-balance-neg"
                            : "st-balance-zero";
                        var balancePrefix = member.NetBalance > 0m ? "+" : "";
                        var canAct = Model.Trip.Status != TripStatus.Completed
                                     && member.Role != TripMemberRole.Owner
                                     && (Model.IsOwner || member.UserId == Model.CurrentUserId);
                        var isSelf = member.UserId == Model.CurrentUserId;

                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="st-avatar-md">@initials</span>
                                    <div>
                                        <div class="fw-semibold text-dark d-flex align-items-center gap-2">
                                            <span>@member.FullName</span>
                                            @if (member.Role == TripMemberRole.Owner)
                                            {
                                                <span class="badge rounded-pill text-bg-dark" style="font-size:0.7rem;">Trưởng đoàn</span>
                                            }
                                            @if (isSelf)
                                            {
                                                <span class="badge rounded-pill bg-light text-secondary border" style="font-size:0.7rem;">Bạn</span>
                                            }
                                        </div>
                                        <div class="small text-muted">@member.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (hasBank)
                                {
                                    <span class="badge rounded-pill text-bg-success-subtle text-success border border-success-subtle">
                                        ✓ @(member.BankCode ?? member.BankBin) sẵn sàng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-light text-muted border">
                                        Chưa cài STK
                                    </span>
                                }
                            </td>
                            <td class="text-end font-monospace small">@member.TotalPaid.ToString("N0")đ</td>
                            <td class="text-end font-monospace small">@member.TotalOwed.ToString("N0")đ</td>
                            <td class="text-end font-monospace small">@(netSettled > 0 ? "+" : "")@netSettled.ToString("N0")đ</td>
                            <td class="text-end">
                                <span class="@balanceClass">@balancePrefix@member.NetBalance.ToString("N0")đ</span>
                            </td>
                            <td class="text-end pe-4">
                                @if (canAct)
                                {
                                    <form method="post" asp-page-handler="RemoveMember" asp-route-id="@Model.Trip.Id" class="d-inline">
                                        <input type="hidden" name="targetUserId" value="@member.UserId" />
                                        <button type="submit"
                                                class="btn btn-sm @(member.NetBalance == 0m ? "btn-outline-danger" : "btn-outline-secondary")"
                                                @(member.NetBalance == 0m ? "" : "disabled")
                                                title="@(member.NetBalance == 0m ? "" : "Không thể rời đoàn khi số dư công nợ chưa về 0đ")">
                                            @(isSelf ? "Rời chuyến" : "Xóa khỏi đoàn")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const root = document.getElementById("stTripWorkspace");
            if (!root) return;
            const tripId = root.getAttribute("data-trip-id");
            const copyBtn = document.getElementById("stCopyInviteBtn");

            if (copyBtn) {
                copyBtn.addEventListener("click", function () {
                    const code = copyBtn.getAttribute("data-code") || "";
                    if (navigator.clipboard && code) {
                        navigator.clipboard.writeText(code).then(function () {
                            copyBtn.textContent = "Đã chép!";
                            if (window.SplitTrip) {
                                window.SplitTrip.showToast("Đã sao chép mã mời", "Mã mời " + code + " đã sẵn sàng gửi cho bạn bè.");
                            }
                            setTimeout(function () { copyBtn.textContent = "Sao chép"; }, 2000);
                        });
                    }
                });
            }

            function formatVnd(amount) {
                const n = Number(amount) || 0;
                return n.toLocaleString("vi-VN") + "đ";
            }

            async function refreshWorkspaceLive(toastTitle, toastMessage) {
                try {
                    const res = await fetch("/Trips/Details?id=" + encodeURIComponent(tripId) + "&handler=LiveState", {
                        headers: { "Accept": "application/json" }
                    });
                    if (!res.ok) {
                        if (res.status === 403) {
                            window.location.href = "/Index";
                        }
                        return;
                    }
                    const data = await res.json();

                    const statusBadge = document.getElementById("stTripStatusBadge");
                    if (statusBadge && data.statusLabel) {
                        statusBadge.className = "st-status-pill " + (data.statusCss || "st-status-planning");
                        statusBadge.textContent = data.statusLabel;
                    }

                    const memberCountEl = document.getElementById("stActiveMemberCount");
                    if (memberCountEl) {
                        memberCountEl.textContent = data.activeMemberCount + " người";
                    }

                    const spendEl = document.getElementById("stTotalSpendKpi");
                    if (spendEl) {
                        spendEl.textContent = formatVnd(data.totalFinalizedSpend);
                    }

                    const sumEl = document.getElementById("stZeroSumBadge");
                    if (sumEl) {
                        sumEl.textContent = "∑ Net = " + formatVnd(data.ledgerNetSum);
                    }

                    if (toastMessage && window.SplitTrip) {
                        window.SplitTrip.showToast(toastTitle || "Cập nhật trực tiếp", toastMessage);
                    }

                    // Reload Owner action buttons cleanly if status changed, otherwise update table rows in place
                    const tbody = document.getElementById("stMembersTableBody");
                    if (tbody && Array.isArray(data.members)) {
                        // Keep anti-forgery token from existing form if present, or reload when actions need fresh tokens
                        const existingTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                        const tokenVal = existingTokenInput ? existingTokenInput.value : "";

                        tbody.innerHTML = "";
                        data.members.forEach(function (m) {
                            const tr = document.createElement("tr");
                            const parts = (m.fullName || "TV").trim().split(/\s+/).slice(-2);
                            const initials = parts.map(function (p) { return (p[0] || "").toUpperCase(); }).join("") || "TV";
                            const bal = Number(m.netBalance) || 0;
                            const balClass = bal > 0 ? "st-balance-pos" : (bal < 0 ? "st-balance-neg" : "st-balance-zero");
                            const balPrefix = bal > 0 ? "+" : "";
                            const netSettled = Number(m.netSettled) || 0;

                            // Column 1: Member
                            const tdUser = document.createElement("td");
                            tdUser.className = "ps-4 py-3";
                            const wrap = document.createElement("div");
                            wrap.className = "d-flex align-items-center gap-3";
                            const avatar = document.createElement("span");
                            avatar.className = "st-avatar-md";
                            avatar.textContent = initials;
                            const info = document.createElement("div");
                            const nameLine = document.createElement("div");
                            nameLine.className = "fw-semibold text-dark d-flex align-items-center gap-2";
                            const nameSpan = document.createElement("span");
                            nameSpan.textContent = m.fullName;
                            nameLine.appendChild(nameSpan);
                            if (m.isOwner) {
                                const b = document.createElement("span");
                                b.className = "badge rounded-pill text-bg-dark";
                                b.style.fontSize = "0.7rem";
                                b.textContent = "Trưởng đoàn";
                                nameLine.appendChild(b);
                            }
                            if (m.isSelf) {
                                const b2 = document.createElement("span");
                                b2.className = "badge rounded-pill bg-light text-secondary border";
                                b2.style.fontSize = "0.7rem";
                                b2.textContent = "Bạn";
                                nameLine.appendChild(b2);
                            }
                            const emailLine = document.createElement("div");
                            emailLine.className = "small text-muted";
                            emailLine.textContent = m.email || "";
                            info.appendChild(nameLine);
                            info.appendChild(emailLine);
                            wrap.appendChild(avatar);
                            wrap.appendChild(info);
                            tdUser.appendChild(wrap);

                            // Column 2: Bank
                            const tdBank = document.createElement("td");
                            const bankBadge = document.createElement("span");
                            if (m.hasBank) {
                                bankBadge.className = "badge rounded-pill text-bg-success-subtle text-success border border-success-subtle";
                                bankBadge.textContent = "✓ " + (m.bankCode || "VietQR") + " sẵn sàng";
                            } else {
                                bankBadge.className = "badge rounded-pill text-bg-light text-muted border";
                                bankBadge.textContent = "Chưa cài STK";
                            }
                            tdBank.appendChild(bankBadge);

                            // Columns 3-5
                            const tdPaid = document.createElement("td");
                            tdPaid.className = "text-end font-monospace small";
                            tdPaid.textContent = formatVnd(m.totalPaid);

                            const tdOwed = document.createElement("td");
                            tdOwed.className = "text-end font-monospace small";
                            tdOwed.textContent = formatVnd(m.totalOwed);

                            const tdSettled = document.createElement("td");
                            tdSettled.className = "text-end font-monospace small";
                            tdSettled.textContent = (netSettled > 0 ? "+" : "") + formatVnd(netSettled);

                            // Column 6: Net
                            const tdNet = document.createElement("td");
                            tdNet.className = "text-end";
                            const netSpan = document.createElement("span");
                            netSpan.className = balClass;
                            netSpan.textContent = balPrefix + formatVnd(bal);
                            tdNet.appendChild(netSpan);

                            // Column 7: Action
                            const tdAct = document.createElement("td");
                            tdAct.className = "text-end pe-4";
                            if (m.canAct && tokenVal) {
                                const form = document.createElement("form");
                                form.method = "post";
                                form.action = "/Trips/Details?id=" + encodeURIComponent(tripId) + "&handler=RemoveMember";
                                form.className = "d-inline";

                                const tok = document.createElement("input");
                                tok.type = "hidden";
                                tok.name = "__RequestVerificationToken";
                                tok.value = tokenVal;

                                const target = document.createElement("input");
                                target.type = "hidden";
                                target.name = "targetUserId";
                                target.value = m.userId;

                                const btn = document.createElement("button");
                                btn.type = "submit";
                                btn.className = "btn btn-sm " + (bal === 0 ? "btn-outline-danger" : "btn-outline-secondary");
                                if (bal !== 0) {
                                    btn.disabled = true;
                                    btn.title = "Không thể rời đoàn khi số dư công nợ chưa về 0đ";
                                }
                                btn.textContent = m.isSelf ? "Rời chuyến" : "Xóa khỏi đoàn";

                                form.appendChild(tok);
                                form.appendChild(target);
                                form.appendChild(btn);
                                tdAct.appendChild(form);
                            } else {
                                tdAct.innerHTML = '<span class="text-muted small">&mdash;</span>';
                            }

                            tr.appendChild(tdUser);
                            tr.appendChild(tdBank);
                            tr.appendChild(tdPaid);
                            tr.appendChild(tdOwed);
                            tr.appendChild(tdSettled);
                            tr.appendChild(tdNet);
                            tr.appendChild(tdAct);
                            tbody.appendChild(tr);
                        });
                    }
                } catch (e) {
                    // Ignore transient network errors
                }
            }

            if (window.SplitTrip && tripId) {
                window.SplitTrip.joinTripRoom(tripId)
                    .then(function (conn) {
                        conn.on("TripMembersChanged", function (payload) {
                            refreshWorkspaceLive("Thành viên chuyến đi", payload && payload.message ? payload.message : "Danh sách thành viên vừa cập nhật.");
                        });
                        conn.on("TripStatusChanged", function (payload) {
                            refreshWorkspaceLive("Trạng thái chuyến đi", payload && payload.message ? payload.message : "Trạng thái chuyến đi đã thay đổi.");
                        });
                        conn.on("TripCompleted", function () {
                            refreshWorkspaceLive("Chuyến đi hoàn tất", "Tất cả công nợ đã tất toán 0đ!");
                        });
                        conn.on("ExpenseAdded", function () { refreshWorkspaceLive("Chi tiêu mới", "Sổ cái số dư vừa cập nhật."); });
                        conn.on("ExpenseUpdated", function () { refreshWorkspaceLive("Cập nhật chi tiêu", "Sổ cái số dư vừa cập nhật."); });
                        conn.on("ExpenseDeleted", function () { refreshWorkspaceLive("Xóa chi tiêu", "Sổ cái số dư vừa cập nhật."); });
                        conn.on("SettlementUpdated", function () { refreshWorkspaceLive("Cập nhật tất toán", "Số dư công nợ vừa được đồng bộ."); });
                    })
                    .catch(function () { });
            }
        })();
    </script>
}
