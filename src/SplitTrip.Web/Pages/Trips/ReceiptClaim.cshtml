@page
@model SplitTrip.Web.Pages.Trips.ReceiptClaimModel
@{
    ViewData["Title"] = $"Tách món AI — {Model.ExpenseSummary.Title}";
    var isDraft = Model.Draft is not null;
    var isClaiming = Model.Board is { ScanStatus: ReceiptScanStatus.ClaimingOpen };
    var isLocked = Model.Board is { ScanStatus: ReceiptScanStatus.Locked };
}

@section Styles {
    <link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />
}

<div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <a href="/Trips/Expenses?tripId=@Model.Trip.Id" class="btn btn-sm st-btn-ghost">
        &larr; Quay lại danh sách Chi tiêu (@Model.Trip.Name)
    </a>

    <div class="st-stepper">
        <div class="st-step-pill @(isDraft ? "active" : "done")">
            <span class="st-step-num">1</span>
            <span>Duyệt nháp AI OCR</span>
        </div>
        <div id="stStepPillClaiming" class="st-step-pill @(isClaiming ? "active" : (isLocked ? "done" : ""))">
            <span class="st-step-num">2</span>
            <span>Cả nhóm chọn món Live</span>
        </div>
        <div id="stStepPillLocked" class="st-step-pill @(isLocked ? "active" : "")">
            <span class="st-step-num">3</span>
            <span>Khóa &amp; Chốt sổ cái</span>
        </div>
    </div>
</div>

@if (Model.Draft is { } draft)
{
    var canEditDraft = Model.IsTripEditable && (draft.PaidByUserId == Model.CurrentUserId || Model.IsOwner);

    <!-- STEP 1: AI OCR DRAFT REVIEW -->
    <div class="st-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="badge rounded-pill text-bg-warning">Bước 1 &middot; Bản nháp AI OCR</span>
                    @if (draft.IsDemoFallback)
                    {
                        <span class="badge rounded-pill text-bg-info">✨ Mẫu Demo AI Thông Minh</span>
                    }
                </div>
                <h1 class="h4 fw-bold mb-1">Kiểm tra &amp; Đối soát dòng món hóa đơn</h1>
                <p class="small text-secondary mb-0">
                    Bản nháp này <strong>chưa cộng vào công nợ chuyến đi</strong> cho tới khi bạn xác nhận số liệu khớp 100% và mở chọn món.
                </p>
            </div>
        </div>

        @if (draft.IsDemoFallback && !string.IsNullOrWhiteSpace(draft.FallbackNotice))
        {
            <div class="alert alert-info py-2 px-3 small mb-3 border-0">
                <strong>💡 Thông tin AI:</strong> @draft.FallbackNotice
            </div>
        }

        <!-- Yellow Mismatch Warning Banner (Server + Live JS synced) -->
        <div id="stLiveMismatchBanner" class="st-mismatch-banner mb-3 @(draft.HasMismatch ? "" : "d-none")">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <div class="fw-bold mb-1">⚠️ Cảnh báo chênh lệch số tiền OCR — Cần đối chiếu trước khi mở chọn món!</div>
                    <div id="stLiveMismatchText" class="small">
                        @(draft.MismatchWarningMessage ?? "Tổng các món + Thuế/Phí - Giảm giá chưa khớp với Tổng hóa đơn.")
                    </div>
                </div>
                @if (canEditDraft)
                {
                    <button type="button" id="stAutoReconcileTotalsBtn" class="btn btn-sm btn-warning fw-semibold flex-shrink-0">
                        ⚡ Tự động tính khớp từ danh sách món
                    </button>
                }
            </div>
        </div>

        <div id="stLiveReconciledBanner" class="st-reconciled-banner mb-3 @(draft.HasMismatch ? "d-none" : "")">
            <span class="fw-bold">✓ Số liệu hóa đơn đã khớp chính xác 100%!</span>
            <span class="small ms-1">Tổng các món = Tạm tính và Tạm tính + Thuế/Phí - Giảm giá = Tổng thanh toán. Sẵn sàng mở chọn món trực tiếp!</span>
        </div>

        <div class="row g-4">
            <!-- Left: Receipt Image / Demo Preview -->
            <div class="col-12 col-lg-4">
                @if (!string.IsNullOrWhiteSpace(draft.ReceiptImageUrl))
                {
                    <div class="st-receipt-preview-frame mb-2">
                        <img src="@draft.ReceiptImageUrl" alt="Ảnh hóa đơn gốc" />
                    </div>
                    <div class="small text-muted text-center">Ảnh hóa đơn đã tải lên</div>
                }
                else
                {
                    <div class="p-4 rounded-4 border bg-light text-center h-100 d-flex flex-column justify-content-center">
                        <div class="display-5 mb-2">🍲</div>
                        <div class="fw-bold text-dark mb-1">Hóa đơn mẫu Demo AI</div>
                        <p class="small text-muted mb-0">
                            Bạn có thể thử sửa đơn giá hoặc xóa bớt 1 món ở bảng bên cạnh để kiểm tra cảnh báo vàng phát hiện sai lệch OCR trực tiếp!
                        </p>
                    </div>
                }
            </div>

            <!-- Right: Editable OCR Lines & Breakdown -->
            <div class="col-12 col-lg-8">
                <form method="post" id="stDraftReviewForm">
                    <input type="hidden" name="Input.TripId" value="@Model.Trip.Id" />
                    <input type="hidden" name="Input.ExpenseId" value="@draft.ExpenseId" />

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-semibold">Tên quán / Hóa đơn</label>
                            <input type="text" class="form-control" name="Input.Title" value="@draft.Title"
                                   maxlength="200" @(canEditDraft ? "" : "readonly") required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Danh mục</label>
                            <select class="form-select" name="Input.Category" @(canEditDraft ? "" : "disabled")>
                                @foreach (var cat in Enum.GetValues<ExpenseCategory>())
                                {
                                    var (catLabel, catIcon) = ExpensesModel.DescribeCategory(cat);
                                    if (draft.Category == cat)
                                    {
                                        <option value="@cat" selected>@catIcon @catLabel</option>
                                    }
                                    else
                                    {
                                        <option value="@cat">@catIcon @catLabel</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-semibold">Người thanh toán</label>
                            <select class="form-select" name="Input.PaidByUserId" @(canEditDraft ? "" : "disabled")>
                                @foreach (var m in Model.ActiveMembers)
                                {
                                    if (m.UserId == draft.PaidByUserId)
                                    {
                                        <option value="@m.UserId" selected>@m.FullName</option>
                                    }
                                    else
                                    {
                                        <option value="@m.UserId">@m.FullName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-uppercase text-secondary">Danh sách món bóc tách (@draft.Items.Count dòng)</span>
                        @if (canEditDraft)
                        {
                            <button type="button" id="stAddDraftItemBtn" class="btn btn-sm st-btn-ghost py-1 px-2 small">
                                + Thêm dòng món
                            </button>
                        }
                    </div>

                    <div class="table-responsive border rounded-3 mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light small text-secondary">
                                <tr>
                                    <th>Tên món / mặt hàng</th>
                                    <th class="text-center" style="width:90px;">SL</th>
                                    <th class="text-end" style="width:140px;">Đơn giá (đ)</th>
                                    <th class="text-end" style="width:150px;">Thành tiền (đ)</th>
                                    <th style="width:52px;"></th>
                                </tr>
                            </thead>
                            <tbody id="stDraftItemsBody">
                                @for (var i = 0; i < draft.Items.Count; i++)
                                {
                                    var item = draft.Items[i];
                                    <tr data-draft-item-row="true">
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   name="Input.Items[@i].ItemName"
                                                   data-field="ItemName"
                                                   value="@item.ItemName"
                                                   @(canEditDraft ? "" : "readonly") required />
                                        </td>
                                        <td>
                                            <input type="number" min="1" step="1" class="form-control form-control-sm text-center"
                                                   name="Input.Items[@i].Quantity"
                                                   data-field="Quantity"
                                                   value="@item.Quantity"
                                                   @(canEditDraft ? "" : "readonly") required />
                                        </td>
                                        <td>
                                            <input type="number" min="0" step="1" class="form-control form-control-sm text-end font-monospace"
                                                   name="Input.Items[@i].UnitPrice"
                                                   data-field="UnitPrice"
                                                   value="@((long)item.UnitPrice)"
                                                   @(canEditDraft ? "" : "readonly") required />
                                        </td>
                                        <td>
                                            <input type="number" min="0" step="1" class="form-control form-control-sm text-end font-monospace fw-semibold"
                                                   name="Input.Items[@i].LineTotal"
                                                   data-field="LineTotal"
                                                   value="@((long)item.LineTotal)"
                                                   @(canEditDraft ? "" : "readonly") required />
                                        </td>
                                        <td class="text-end">
                                            @if (canEditDraft)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" data-remove-draft-row title="Xóa dòng">&times;</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light small">
                                <tr>
                                    <td colspan="3" class="text-end fw-semibold">Tổng cộng các dòng món:</td>
                                    <td class="text-end font-monospace fw-bold text-dark" id="stDraftItemsSumDisplay">@draft.ItemsSum.ToString("N0")đ</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Tạm tính (đ)</label>
                            <input type="number" min="0" step="1" class="form-control font-monospace"
                                   id="stDraftSubtotal" name="Input.SubtotalAmount"
                                   value="@((long)draft.SubtotalAmount)" @(canEditDraft ? "" : "readonly") required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">+ Thuế VAT / Phí (đ)</label>
                            <input type="number" min="0" step="1" class="form-control font-monospace"
                                   id="stDraftTaxOrTip" name="Input.TaxOrTipAmount"
                                   value="@((long)draft.TaxOrTipAmount)" @(canEditDraft ? "" : "readonly") required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">- Giảm giá / Voucher (đ)</label>
                            <input type="number" min="0" step="1" class="form-control font-monospace"
                                   id="stDraftDiscount" name="Input.DiscountAmount"
                                   value="@((long)draft.DiscountAmount)" @(canEditDraft ? "" : "readonly") required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold text-dark">= Tổng thanh toán (đ)</label>
                            <input type="number" min="1" step="1" class="form-control font-monospace fw-bold"
                                   id="stDraftTotal" name="Input.TotalAmount"
                                   value="@((long)draft.TotalAmount)" @(canEditDraft ? "" : "readonly") required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Ghi chú hóa đơn</label>
                        <input type="text" class="form-control" name="Input.Notes" value="@draft.Notes"
                               maxlength="1000" @(canEditDraft ? "" : "readonly") />
                    </div>

                    @if (canEditDraft)
                    {
                        <div class="d-flex flex-wrap justify-content-end gap-2">
                            <button type="submit" asp-page-handler="SaveDraft" class="btn st-btn-ghost">
                                Lưu bản nháp
                            </button>
                            <button type="submit"
                                    id="stPublishClaimingBtn"
                                    asp-page-handler="PublishClaiming"
                                    class="btn st-btn-primary"
                                    disabled="@draft.HasMismatch">
                                ✓ Xác nhận &amp; Mở chọn món Live &rarr;
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted text-end">
                            Đang chờ người thanh toán (@draft.PaidByName) hoặc Trưởng đoàn xác nhận bản nháp này.
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
}
else if (Model.Board is { } board)
{
    var locked = board.ScanStatus == ReceiptScanStatus.Locked;

    <!-- STEP 2 & 3: LIVE SIGNALR ITEM CLAIMING BOARD -->
    <div id="stLiveClaimingBoard"
         data-trip-id="@board.TripId"
         data-expense-id="@board.ExpenseId"
         data-current-user-id="@Model.CurrentUserId"
         data-is-owner="@(Model.IsOwner ? "true" : "false")">

        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left / Main Column: Interactive Dish Claiming Cards -->
            <div class="col-12 col-lg-7">
                <div class="st-card p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span id="stClaimScanStatusBadge"
                                      class="badge rounded-pill @(locked ? "text-bg-success" : "text-bg-primary")">
                                    @(locked ? "🔒 Đã khóa & chốt sổ" : "🟢 Đang mở nhận món Live")
                                </span>
                                <span class="badge bg-light text-secondary border">
                                    <span class="text-success me-1">●</span> Đồng bộ SignalR tức thì
                                </span>
                            </div>
                            <h1 class="h4 fw-bold mb-1">@board.Title</h1>
                            <div class="small text-muted">
                                Người ứng trả bill: <strong class="text-dark">@board.PaidByName</strong>
                                &middot; Bấm vào từng món bạn đã ăn (nhiều người cùng chọn 1 món sẽ tự chia đều món đó!).
                            </div>
                        </div>
                    </div>

                    <div id="stUnclaimedBanner" class="@(locked || board.AllItemsClaimed ? "st-reconciled-banner" : "st-mismatch-banner") mb-3">
                        @if (locked)
                        {
                            <strong>✓ Hóa đơn đã khóa &amp; chốt sổ cái!</strong>
                            <span>Mọi thành viên đã được phân bổ chính xác theo tỷ lệ món + VAT/giảm giá.</span>
                        }
                        else if (board.UnclaimedItemCount > 0)
                        {
                            <strong>Còn @board.UnclaimedItemCount món chưa có người nhận (@board.UnclaimedSubtotalAmount.ToString("N0")đ).</strong>
                            <span>Hãy bấm vào món bạn đã dùng hoặc dùng chung để chia đều món đó!</span>
                        }
                        else
                        {
                            <strong>✓ Tất cả @board.TotalItemCount món đều đã có người nhận!</strong>
                            <span>Người trả tiền hoặc Trưởng đoàn có thể bấm <em>Khóa &amp; Chốt sổ</em> ngay bây giờ.</span>
                        }
                    </div>

                    <div id="stClaimDishList">
                        @foreach (var item in board.Items)
                        {
                            var cardClasses = "st-dish-card mb-2"
                                + (item.IsClaimedByViewer ? " is-claimed-by-me" : "")
                                + (item.IsUnclaimed ? " is-unclaimed" : "")
                                + (locked || !board.IsTripEditable ? " is-locked" : "");

                            <div class="@cardClasses" data-dish-item-id="@item.Id">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <span class="st-dish-check mt-1">@(item.IsClaimedByViewer ? "✓" : "")</span>
                                        <div>
                                            <div class="fw-bold text-dark">@item.ItemName</div>
                                            <div class="small text-muted">SL: @item.Quantity &times; @item.UnitPrice.ToString("N0")đ</div>
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @if (item.IsUnclaimed)
                                                {
                                                    <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                        Chưa ai nhận
                                                    </span>
                                                }
                                                else
                                                {
                                                    @foreach (var c in item.Claimers)
                                                    {
                                                        <span class="st-claimer-pill">
                                                            <span class="st-claimer-avatar">@c.Initials</span>
                                                            <span>@(c.UserId == Model.CurrentUserId ? "Bạn" : c.FullName)</span>
                                                            <span class="text-muted font-monospace">(@c.DishShareVnd.ToString("N0")đ)</span>
                                                        </span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-end flex-shrink-0">
                                        <div class="fw-bold font-monospace text-dark">@item.LineTotal.ToString("N0")đ</div>
                                        @if (item.Claimers.Count > 1)
                                        {
                                            <div class="small fw-semibold" style="color: var(--st-primary);">
                                                Chia @item.Claimers.Count người
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Live Pro-Rata VAT/Discount Summary & Lock Button -->
            <div class="col-12 col-lg-5">
                <div class="st-card p-4 sticky-lg-top" style="top: 84px;">
                    <h2 class="h6 fw-bold text-uppercase text-secondary mb-3">
                        Tổng hợp hóa đơn &amp; Phân bổ Pro-Rata Live
                    </h2>

                    <div class="p-3 rounded-3 bg-light border mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">Tạm tính các món:</span>
                            <span class="font-monospace fw-semibold">@board.SubtotalAmount.ToString("N0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">+ Thuế VAT / Phí phục vụ:</span>
                            <span class="font-monospace text-dark">+@board.TaxOrTipAmount.ToString("N0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <span class="text-secondary">- Giảm giá / Voucher:</span>
                            <span class="font-monospace text-success">-@board.DiscountAmount.ToString("N0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">Tổng thanh toán (100%):</span>
                            <span class="h5 fw-bold font-monospace mb-0 text-dark">@board.TotalAmount.ToString("N0")đ</span>
                        </div>
                    </div>

                    <div class="small text-muted mb-2">
                        Thuế/phí và giảm giá được chia tự động theo đúng tỷ lệ tiền món của từng người (làm tròn nguyên VNĐ):
                    </div>

                    <div id="stMemberProRataList" class="mb-3">
                        @foreach (var m in board.MemberPreviews)
                        {
                            var adjText = m.ProRataAdjustmentVnd == 0m
                                ? "0đ"
                                : $"{(m.ProRataAdjustmentVnd > 0m ? "+" : "")}{m.ProRataAdjustmentVnd:N0}đ";

                            <div class="p-3 border rounded-3 mb-2 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="st-avatar-sm">@m.Initials</span>
                                        <div>
                                            <span class="fw-semibold text-dark small">@m.FullName</span>
                                            @if (m.UserId == Model.CurrentUserId)
                                            {
                                                <span class="badge bg-light text-secondary border" style="font-size:0.68rem;">Bạn</span>
                                            }
                                            @if (m.IsPayer)
                                            {
                                                <span class="badge text-bg-dark" style="font-size:0.68rem;">Đã trả bill</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="fw-bold font-monospace text-dark">@m.LedgerOwedAmount.ToString("N0")đ</div>
                                </div>
                                <div class="d-flex flex-wrap justify-content-between small text-muted" style="font-size:0.78rem;">
                                    <span>Đã chọn @m.ClaimedItemCount món (@m.ClaimedDishSubtotal.ToString("N0")đ)</span>
                                    <span>VAT/Giảm giá: <strong class="font-monospace">@adjText</strong></span>
                                </div>
                                @if (m.UnclaimedFallbackSubtotal > 0m)
                                {
                                    <div class="small text-warning-emphasis mt-1" style="font-size:0.75rem;">
                                        * Đang tạm giữ @m.UnclaimedFallbackSubtotal.ToString("N0")đ món chưa ai nhận
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div id="stLockClaimControls" class="@(board.CanManageLock && !locked ? "" : "d-none")">
                        <form method="post" asp-page-handler="LockClaims" class="d-grid">
                            <input type="hidden" name="tripId" value="@board.TripId" />
                            <input type="hidden" name="expenseId" value="@board.ExpenseId" />
                            <button type="submit"
                                    id="stLockClaimsBtn"
                                    class="btn st-btn-primary py-2"
                                    @(board.AllItemsClaimed ? "" : "disabled")
                                    title="@(board.AllItemsClaimed ? "Khóa nhận món và chốt sổ cái" : "Cần tất cả các món đều có ít nhất 1 người nhận trước khi khóa")">
                                🔒 Khóa &amp; Chốt chia tiền hóa đơn
                            </button>
                        </form>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(board.ReceiptImageUrl))
                    {
                        <div class="mt-3 pt-3 border-top text-center">
                            <a href="@board.ReceiptImageUrl" target="_blank" rel="noopener" class="small st-link-teal text-decoration-none">
                                Xem ảnh hóa đơn gốc ↗
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/expenses.js" asp-append-version="true"></script>
}
