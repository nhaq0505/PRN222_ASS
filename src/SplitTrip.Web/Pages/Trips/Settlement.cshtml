@page
@model SplitTrip.Web.Pages.Trips.SettlementModel
@{
    var trip = Model.Workspace.Trip;
    ViewData["Title"] = $"Tất toán VietQR — {trip.Name}";
    var statusMeta = DetailsModel.DescribeStatus(trip.Status);
    var orderedBalances = trip.MemberBalances
        .OrderByDescending(b => b.NetBalance)
        .ThenBy(b => b.FullName)
        .ToList();
    var maxAbsBalance = orderedBalances.Count > 0
        ? Math.Max(1m, orderedBalances.Max(b => Math.Abs(b.NetBalance)))
        : 1m;
    var allBalancesZero = orderedBalances.All(b => b.NetBalance == 0m) && Model.Workspace.ActiveSettlements.Count == 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/settlement.css" asp-append-version="true" />
}

<div id="stSettlementWorkspace" data-trip-id="@trip.Id">
    <!-- Trip Header -->
    <div class="st-card p-4 mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span id="stTripStatusBadge" class="st-status-pill @statusMeta.Css">@statusMeta.Label</span>
                    <span class="text-muted small">
                        📍 @trip.Destination &middot; @trip.StartDate.ToString("dd/MM/yyyy") &rarr; @trip.EndDate.ToString("dd/MM/yyyy") (@trip.DayCount ngày)
                    </span>
                </div>
                <h1 class="h3 fw-bold mb-1">@trip.Name</h1>
                <p class="text-secondary small mb-0">
                    Sổ cái cân bằng tổng bằng 0 (Zero-Sum Ledger) &middot; Rút gọn nợ chéo bằng thuật toán <strong>Min-Cash-Flow</strong> &amp; thanh toán 2 bước <strong>Napas VietQR</strong>.
                </p>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="st-invite-box" title="Mã mời tham gia chuyến đi">
                    <span class="text-muted small fw-normal" style="letter-spacing:0;">Mã mời:</span>
                    <span>@trip.InviteCode</span>
                    <button type="button" class="btn btn-sm btn-light border py-0 px-2 small"
                            data-copy-value="@trip.InviteCode"
                            data-copy-label="Đã sao chép mã mời">
                        Sao chép
                    </button>
                </div>
            </div>
        </div>

        <div id="stOwnerLifecycleStrip">
            @if (Model.IsOwner && trip.Status != TripStatus.Completed)
            {
                <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="small text-muted">
                        <strong class="text-dark">Điều khiển tất toán (Trưởng đoàn):</strong>
                        @if (trip.Status == TripStatus.Ongoing)
                        {
                            <span>Khóa chi tiêu để cố định bảng phân chia VietQR cho các thành viên.</span>
                        }
                        else if (trip.Status == TripStatus.Settling)
                        {
                            <span>Chuyến đi tự động hoàn tất ngay khi khoản thanh toán cuối cùng được xác nhận về 0đ.</span>
                        }
                        else
                        {
                            <span>Chuyển sang Đang diễn ra khi bắt đầu phát sinh chi tiêu.</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (trip.Status == TripStatus.Ongoing)
                        {
                            <form method="post" asp-page-handler="TransitionStatus" class="m-0">
                                <input type="hidden" name="tripId" value="@trip.Id" />
                                <input type="hidden" name="targetStatus" value="@TripStatus.Settling" />
                                <button type="submit" class="btn btn-sm btn-warning fw-semibold">
                                    Khóa chi tiêu &amp; Bắt đầu Tất toán →
                                </button>
                            </form>
                        }
                        else if (trip.Status == TripStatus.Settling)
                        {
                            <form method="post" asp-page-handler="TransitionStatus" class="m-0">
                                <input type="hidden" name="tripId" value="@trip.Id" />
                                <input type="hidden" name="targetStatus" value="@TripStatus.Ongoing" />
                                <button type="submit" class="btn btn-sm st-btn-ghost">
                                    ↺ Mở lại thêm chi tiêu bù
                                </button>
                            </form>
                            <form method="post" asp-page-handler="TransitionStatus" class="m-0">
                                <input type="hidden" name="tripId" value="@trip.Id" />
                                <input type="hidden" name="targetStatus" value="@TripStatus.Completed" />
                                <button type="submit" class="btn btn-sm btn-success fw-semibold"
                                        @(allBalancesZero ? "" : "disabled")
                                        title="@(allBalancesZero ? "Đóng sổ cái và hoàn tất chuyến đi" : "Cần tất toán hết các giao dịch về 0đ trước khi hoàn tất")">
                                    ✓ Đóng sổ &amp; Hoàn tất chuyến đi
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Sub-Navigation Workspace Tabs -->
    <nav class="st-trip-tabs mb-4" aria-label="Điều hướng không gian chuyến đi">
        <a class="st-trip-tab" asp-page="/Trips/Details" asp-route-id="@trip.Id">
            Tổng quan &amp; Thành viên
        </a>
        <a class="st-trip-tab" href="/Trips/Itinerary?tripId=@trip.Id">
            Lịch trình &amp; AI Planner
        </a>
        <a class="st-trip-tab" href="/Trips/Expenses?tripId=@trip.Id">
            Chi tiêu &amp; Quét hóa đơn
        </a>
        <a class="st-trip-tab active" href="/Trips/Settlement?tripId=@trip.Id">
            Tất toán VietQR
        </a>
    </nav>

    <div id="stSettlementDynamicZone">
        <!-- Min-Cash-Flow Efficiency Callout -->
        <div class="st-efficiency-banner p-4 mb-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        @if (Model.Workspace.EliminatedTransfersCount > 0)
                        {
                            <span class="st-efficiency-pill">
                                ✨ Rút gọn @Model.Workspace.EliminatedTransfersCount giao dịch chéo! (-@Model.Workspace.ReductionPercentage%)
                            </span>
                        }
                        else
                        {
                            <span class="st-efficiency-pill">
                                ⚡ Tối ưu đồ thị Min-Cash-Flow (≤ N − 1 giao dịch)
                            </span>
                        }
                        <span class="badge rounded-pill @(Model.Workspace.IsZeroSumBalanced ? "text-bg-success" : "text-bg-danger")">
                            ∑ NetBalance = @Model.Workspace.LedgerNetSum.ToString("N0")đ
                        </span>
                    </div>
                    <div class="text-dark fw-semibold">
                        @if (Model.Workspace.EliminatedTransfersCount > 0)
                        {
                            <span>
                                Từ <strong>@Model.Workspace.NaivePairwiseCount</strong> nghĩa vụ nợ chéo giữa các hóa đơn, thuật toán Min-Cash-Flow đã triệt tiêu nợ vòng tròn xuống chỉ còn <strong>@Model.Workspace.SimplifiedTransferCount</strong> lệnh chuyển khoản tối thiểu.
                            </span>
                        }
                        else if (Model.Workspace.SimplifiedTransferCount > 0)
                        {
                            <span>
                                Sổ cái hiện chỉ cần đúng <strong>@Model.Workspace.SimplifiedTransferCount</strong> lệnh chuyển khoản trực tiếp để đưa toàn bộ thành viên về <strong>0đ</strong>.
                            </span>
                        }
                        else
                        {
                            <span>
                                Tuyệt vời! Không phát sinh nợ chéo hoặc toàn bộ công nợ của đoàn đã được tất toán cân bằng về <strong>0đ</strong>.
                            </span>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <div class="bg-white border rounded-3 px-3 py-2 text-end">
                        <div class="small text-muted">Cần chuyển còn lại</div>
                        <div class="h5 fw-bold text-danger mb-0">@Model.Workspace.TotalRemainingAmount.ToString("N0")đ</div>
                    </div>
                    <div class="bg-white border rounded-3 px-3 py-2 text-end">
                        <div class="small text-muted">Đã xác nhận tất toán</div>
                        <div class="h5 fw-bold text-success mb-0">@Model.Workspace.TotalConfirmedAmount.ToString("N0")đ</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Left Column: Zero-Sum NetBalance Leaderboard -->
            <div class="col-12 col-lg-5">
                <div class="st-card h-100">
                    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-1">Bảng xếp hạng Số dư ròng</h2>
                            <p class="small text-muted mb-0">Xanh: được nhận lại &middot; Đỏ: cần chuyển trả</p>
                        </div>
                        <span class="badge bg-light text-secondary border">@orderedBalances.Count người</span>
                    </div>

                    <div class="p-3 d-flex flex-column gap-3">
                        @foreach (var member in orderedBalances)
                        {
                            var initials = SettlementModel.ExtractInitials(member.FullName);
                            var isSelf = member.UserId == Model.CurrentUserId;
                            var hasBank = !string.IsNullOrWhiteSpace(member.BankBin ?? member.BankCode)
                                          && !string.IsNullOrWhiteSpace(member.BankAccountNumber);
                            var widthPct = member.NetBalance == 0m
                                ? 0
                                : Math.Max(6, (int)Math.Round(Math.Abs(member.NetBalance) * 100m / maxAbsBalance));
                            var netSettled = member.SettlementsPaid - member.SettlementsReceived;

                            <div class="p-3 rounded-3 border bg-light bg-opacity-50">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="st-avatar-md">@initials</span>
                                        <div>
                                            <div class="fw-semibold text-dark d-flex flex-wrap align-items-center gap-1">
                                                <span>@member.FullName</span>
                                                @if (isSelf)
                                                {
                                                    <span class="badge rounded-pill bg-white text-secondary border" style="font-size:0.7rem;">Bạn</span>
                                                }
                                            </div>
                                            <div class="small text-muted">
                                                @if (member.NetBalance > 0m)
                                                {
                                                    if (hasBank)
                                                    {
                                                        <span class="text-success fw-medium">✓ VietQR @(member.BankCode ?? member.BankBin)</span>
                                                    }
                                                    else if (isSelf)
                                                    {
                                                        <a asp-page="/Account/Profile" class="text-danger fw-semibold text-decoration-none">
                                                            + Cài STK nhận VietQR ngay →
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-warning-emphasis">Chưa cập nhật STK VietQR</span>
                                                    }
                                                }
                                                else if (member.NetBalance < 0m)
                                                {
                                                    <span>Người có nghĩa vụ thanh toán</span>
                                                }
                                                else
                                                {
                                                    <span>Đã tất toán cân bằng 0đ</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-end">
                                        @if (member.NetBalance > 0m)
                                        {
                                            <div class="st-balance-pos">+@member.NetBalance.ToString("N0")đ</div>
                                            <span class="badge rounded-pill text-bg-success-subtle text-success border border-success-subtle">Chủ nợ</span>
                                        }
                                        else if (member.NetBalance < 0m)
                                        {
                                            <div class="st-balance-neg">@member.NetBalance.ToString("N0")đ</div>
                                            <span class="badge rounded-pill text-bg-danger-subtle text-danger border border-danger-subtle">Cần trả</span>
                                        }
                                        else
                                        {
                                            <div class="st-balance-zero">0đ</div>
                                            <span class="badge rounded-pill bg-white text-secondary border">Cân bằng</span>
                                        }
                                    </div>
                                </div>

                                @if (member.NetBalance != 0m)
                                {
                                    <div class="st-ledger-bar-track mb-2">
                                        <div class="@(member.NetBalance > 0m ? "st-ledger-bar-pos" : "st-ledger-bar-neg")"
                                             style="width: @(widthPct)%;"></div>
                                    </div>
                                }

                                <div class="d-flex flex-wrap justify-content-between gap-2 small text-muted pt-1 border-top">
                                    <span>Ứng chi: <strong class="text-dark">@member.TotalPaid.ToString("N0")đ</strong></span>
                                    <span>Phải trả: <strong class="text-dark">@member.TotalOwed.ToString("N0")đ</strong></span>
                                    <span>Đã tất toán: <strong class="text-dark">@(netSettled > 0 ? "+" : "")@netSettled.ToString("N0")đ</strong></span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Simplified Transfers & 2-Step Handshake -->
            <div class="col-12 col-lg-7">
                <div class="st-card h-100">
                    <div class="p-4 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                        <div>
                            <h2 class="h5 fw-bold mb-1">Lệnh chuyển khoản tối ưu &amp; Xác nhận 2 bước</h2>
                            <p class="small text-muted mb-0">
                                Bước 1: Người nợ quét VietQR &amp; báo đã chuyển &rarr; Bước 2: Chủ nợ xác nhận đã nhận tiền.
                            </p>
                        </div>

                        @if (trip.Status != TripStatus.Completed)
                        {
                            <form method="post" asp-page-handler="SyncPlan" class="m-0">
                                <input type="hidden" name="tripId" value="@trip.Id" />
                                <button type="submit" class="btn btn-sm st-btn-ghost">
                                    ↻ Tính lại tối ưu
                                </button>
                            </form>
                        }
                    </div>

                    <div class="p-4">
                        @if (Model.Workspace.ActiveSettlements.Count == 0)
                        {
                            <div class="text-center py-5 px-3">
                                <div class="display-6 mb-2">🎉</div>
                                <h3 class="h5 fw-bold text-dark mb-1">Không còn giao dịch công nợ nào đang chờ!</h3>
                                <p class="text-muted small mb-0">
                                    Tất cả các khoản chi tiêu đã xác thực trong chuyến đi đều đã cân bằng sổ cái về 0đ.
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var item in Model.Workspace.ActiveSettlements)
                                {
                                    var statusMetaCard = SettlementModel.DescribeSettlementStatus(item.Status);
                                    var cardCss = item.Status switch
                                    {
                                        SettlementStatus.MarkedPaid => "st-transfer-card-marked",
                                        SettlementStatus.Disputed => "st-transfer-card-disputed",
                                        _ => "st-transfer-card-pending"
                                    };
                                    var isDebtor = item.FromUserId == Model.CurrentUserId;
                                    var isCreditor = item.ToUserId == Model.CurrentUserId;
                                    var canMarkPaid = isDebtor
                                                      && trip.Status != TripStatus.Completed
                                                      && item.Status is SettlementStatus.Pending or SettlementStatus.Disputed;
                                    var canConfirmOrDispute = isCreditor
                                                              && trip.Status != TripStatus.Completed
                                                              && item.Status == SettlementStatus.MarkedPaid;
                                    var canNudge = (isCreditor || Model.IsOwner)
                                                   && !isDebtor
                                                   && trip.Status != TripStatus.Completed
                                                   && item.Status is SettlementStatus.Pending or SettlementStatus.Disputed;

                                    <div class="st-transfer-card @cardCss">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                            <span class="badge rounded-pill @statusMetaCard.BadgeCss">@statusMetaCard.Label</span>
                                            <span class="font-monospace small text-muted">Nội dung CK: <strong>@item.TransferNote</strong></span>
                                        </div>

                                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="st-avatar-sm bg-danger-subtle text-danger">@SettlementModel.ExtractInitials(item.FromUserName)</span>
                                                <div>
                                                    <div class="fw-semibold text-dark">
                                                        @item.FromUserName
                                                        @if (isDebtor)
                                                        {
                                                            <span class="badge bg-light text-dark border ms-1">Bạn chuyển</span>
                                                        }
                                                    </div>
                                                    <div class="small text-muted">Người chuyển</div>
                                                </div>
                                            </div>

                                            <div class="text-md-center">
                                                <div class="h4 fw-bold text-dark mb-0">@item.Amount.ToString("N0")đ</div>
                                                <span class="st-transfer-arrow">Chuyển tới &rarr;</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-2 justify-content-md-end">
                                                <div class="text-md-end">
                                                    <div class="fw-semibold text-dark">
                                                        @item.ToUserName
                                                        @if (isCreditor)
                                                        {
                                                            <span class="badge bg-light text-dark border ms-1">Bạn nhận</span>
                                                        }
                                                    </div>
                                                    <div class="small text-muted">
                                                        @if (item.VietQr.IsBankConfigured)
                                                        {
                                                            <span class="text-success fw-medium">@item.VietQr.BankShortName &middot; @item.VietQr.AccountNumber</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-danger">Chưa cài STK VietQR</span>
                                                        }
                                                    </div>
                                                </div>
                                                <span class="st-avatar-sm">@SettlementModel.ExtractInitials(item.ToUserName)</span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.ProofNote))
                                        {
                                            <div class="p-2 px-3 rounded-3 bg-white border small mb-2">
                                                <strong class="text-dark">Ghi chú chuyển khoản:</strong>
                                                <span class="text-secondary">@item.ProofNote</span>
                                                @if (item.MarkedPaidAtUtc.HasValue)
                                                {
                                                    <span class="text-muted ms-1">(@item.MarkedPaidAtUtc.Value.ToLocalTime().ToString("dd/MM HH:mm"))</span>
                                                }
                                            </div>
                                        }

                                        @if (item.Status == SettlementStatus.Disputed && !string.IsNullOrWhiteSpace(item.DisputeReason))
                                        {
                                            <div class="p-2 px-3 rounded-3 bg-white border border-danger-subtle text-danger small mb-2">
                                                <strong>Phản hồi từ chủ nợ:</strong> @item.DisputeReason
                                            </div>
                                        }

                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="button"
                                                        class="btn btn-sm @(isDebtor ? "st-btn-primary" : "st-btn-ghost")"
                                                        data-open-vietqr="true"
                                                        data-settlement-id="@item.Id"
                                                        data-has-bank="@(item.VietQr.IsBankConfigured ? "true" : "false")"
                                                        data-qr-url="@item.VietQr.QrImageUrl"
                                                        data-bank-name="@(item.VietQr.BankShortName ?? item.VietQr.BankCode ?? "Ngân hàng")"
                                                        data-bank-bin="@item.VietQr.BankBin"
                                                        data-account-no="@item.VietQr.AccountNumber"
                                                        data-account-holder="@item.VietQr.AccountHolder"
                                                        data-amount="@((long)item.Amount)"
                                                        data-transfer-note="@item.TransferNote"
                                                        data-creditor-name="@item.ToUserName"
                                                        data-missing-msg="@item.VietQr.MissingBankMessage"
                                                        data-can-mark-paid="@(canMarkPaid ? "true" : "false")">
                                                    @(isDebtor ? "📱 Quét mã VietQR & Thanh toán" : "🔍 Xem mã VietQR")
                                                </button>

                                                @if (canMarkPaid)
                                                {
                                                    <form method="post" asp-page-handler="MarkPaid" class="d-inline">
                                                        <input type="hidden" name="tripId" value="@trip.Id" />
                                                        <input type="hidden" name="settlementId" value="@item.Id" />
                                                        <input type="hidden" name="proofNote" value="Đã chuyển khoản đúng nội dung VietQR" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success fw-semibold">
                                                            ✓ Tôi đã chuyển khoản
                                                        </button>
                                                    </form>
                                                }

                                                @if (canConfirmOrDispute)
                                                {
                                                    <form method="post" asp-page-handler="ConfirmReceived" class="d-inline">
                                                        <input type="hidden" name="tripId" value="@trip.Id" />
                                                        <input type="hidden" name="settlementId" value="@item.Id" />
                                                        <button type="submit" class="btn btn-sm btn-success fw-semibold">
                                                            ✓ Xác nhận đã nhận
                                                        </button>
                                                    </form>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger fw-semibold"
                                                            data-open-dispute="true"
                                                            data-settlement-id="@item.Id"
                                                            data-debtor-name="@item.FromUserName"
                                                            data-amount="@((long)item.Amount)">
                                                        ⚠ Báo chưa nhận
                                                    </button>
                                                }
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                @if (item.LastNudgedAtUtc.HasValue)
                                                {
                                                    <span class="text-muted" style="font-size:0.75rem;">
                                                        Đã nhắc lúc @item.LastNudgedAtUtc.Value.ToLocalTime().ToString("dd/MM HH:mm")
                                                    </span>
                                                }

                                                @if (canNudge)
                                                {
                                                    <form method="post" asp-page-handler="Nudge" class="d-inline">
                                                        <input type="hidden" name="tripId" value="@trip.Id" />
                                                        <input type="hidden" name="settlementId" value="@item.Id" />
                                                        <button type="submit" class="btn btn-sm btn-light border small">
                                                            🔔 Nhắc nợ
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Settled History Log -->
        <div class="st-card overflow-hidden">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h5 fw-bold mb-1">Nhật ký giao dịch đã tất toán (Settled History)</h2>
                    <p class="small text-muted mb-0">Lưu vết đầy đủ thời gian báo chuyển khoản và thời gian chủ nợ xác nhận.</p>
                </div>
                <span class="badge rounded-pill text-bg-success">@Model.Workspace.ConfirmedHistory.Count hoàn tất</span>
            </div>

            @if (Model.Workspace.ConfirmedHistory.Count == 0)
            {
                <div class="p-4 text-center text-muted small">
                    Chưa có giao dịch tất toán nào hoàn tất xác nhận 2 bước.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light small text-uppercase text-secondary">
                            <tr>
                                <th class="ps-4">Người chuyển &rarr; Người nhận</th>
                                <th class="text-end">Số tiền</th>
                                <th>Nội dung / Ghi chú</th>
                                <th>Báo chuyển lúc</th>
                                <th class="pe-4">Xác nhận lúc</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var done in Model.Workspace.ConfirmedHistory)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-semibold text-dark">
                                            @done.FromUserName <span class="text-muted mx-1">&rarr;</span> @done.ToUserName
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold text-success font-monospace">@done.Amount.ToString("N0")đ</td>
                                    <td>
                                        <div class="small font-monospace text-dark">@done.TransferNote</div>
                                        @if (!string.IsNullOrWhiteSpace(done.ProofNote))
                                        {
                                            <div class="small text-muted">Ghi chú: @done.ProofNote</div>
                                        }
                                    </td>
                                    <td class="small text-secondary">
                                        @(done.MarkedPaidAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                                    </td>
                                    <td class="pe-4 small text-success fw-medium">
                                        ✓ @(done.ConfirmedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? done.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Interactive VietQR Modal -->
<div class="modal fade" id="stVietQrModal" tabindex="-1" aria-labelledby="stVietQrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 18px;">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="stVietQrModalLabel">Thanh toán chuyển khoản nhanh Napas VietQR</h5>
                    <div class="small text-muted">Người thụ hưởng: <strong class="text-dark" id="stQrCreditorName"></strong></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-12 col-md-6">
                        <div id="stQrConfiguredBox" class="st-qr-frame">
                            <span id="stQrBankBadge" class="badge rounded-pill text-bg-dark mb-2">VietQR 247</span>
                            <img id="stQrImage" src="" alt="Mã thanh toán Napas VietQR" class="st-qr-img" />
                            <div id="stQrImgFallback" class="d-none text-center p-3 small text-muted">
                                Không tải được ảnh QR trực tuyến — vui lòng sao chép STK &amp; nội dung chuyển khoản bên cạnh.
                            </div>
                            <div class="small text-muted mt-2 text-center">
                                Mở ứng dụng Ngân hàng / Ví điện tử bất kỳ để quét tự động điền số tiền &amp; nội dung
                            </div>
                        </div>

                        <div id="stQrMissingBox" class="d-none p-4 rounded-4 border border-warning bg-warning-subtle text-dark">
                            <div class="fw-bold mb-1">⚠ Chưa có thông tin tài khoản VietQR</div>
                            <p id="stQrMissingText" class="small mb-0"></p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 d-flex flex-column gap-3">
                        <div>
                            <div class="small text-muted mb-1">Số tài khoản thụ hưởng</div>
                            <div class="st-copy-field">
                                <span id="stQrAccountNo" class="st-copy-value"></span>
                                <button type="button" id="stQrCopyAccountBtn" class="btn btn-sm btn-light border"
                                        data-copy-value="" data-copy-label="Đã sao chép số tài khoản">
                                    Sao chép STK
                                </button>
                            </div>
                        </div>

                        <div>
                            <div class="small text-muted mb-1">Chủ tài khoản</div>
                            <div class="st-copy-field">
                                <span id="stQrAccountHolder" class="st-copy-value"></span>
                            </div>
                        </div>

                        <div>
                            <div class="small text-muted mb-1">Số tiền chính xác (VND)</div>
                            <div class="st-copy-field">
                                <span id="stQrAmountText" class="st-copy-value text-danger fs-5"></span>
                                <button type="button" id="stQrCopyAmountBtn" class="btn btn-sm btn-light border"
                                        data-copy-value="" data-copy-label="Đã sao chép số tiền">
                                    Sao chép số tiền
                                </button>
                            </div>
                        </div>

                        <div>
                            <div class="small text-muted mb-1">Nội dung chuyển khoản</div>
                            <div class="st-copy-field">
                                <span id="stQrTransferNote" class="st-copy-value"></span>
                                <button type="button" id="stQrCopyNoteBtn" class="btn btn-sm btn-light border"
                                        data-copy-value="" data-copy-label="Đã sao chép nội dung CK">
                                    Sao chép
                                </button>
                            </div>
                        </div>

                        <form id="stModalMarkPaidForm" method="post" asp-page-handler="MarkPaid" class="pt-2 border-top">
                            <input type="hidden" name="tripId" value="@trip.Id" />
                            <input type="hidden" id="stModalSettlementId" name="settlementId" value="" />
                            <label for="stModalProofInput" class="form-label small fw-semibold mb-1">
                                Ghi chú giao dịch / Mã tham chiếu (tùy chọn)
                            </label>
                            <input type="text" id="stModalProofInput" name="proofNote" maxlength="500"
                                   class="form-control form-control-sm mb-2"
                                   placeholder="VD: Đã chuyển từ MB Bank lúc 20:45 (FT26320...)" />
                            <button type="submit" class="btn st-btn-primary w-100">
                                ✓ Tôi đã chuyển khoản xong (Gửi xác nhận Bước 1)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dispute Modal (Step 2 Exception) -->
<div class="modal fade" id="stDisputeModal" tabindex="-1" aria-labelledby="stDisputeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Dispute" class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0 text-danger" id="stDisputeModalLabel">Báo chưa nhận được khoản chuyển</h5>
                    <div id="stDisputeSummary" class="small text-muted"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="tripId" value="@trip.Id" />
                <input type="hidden" id="stDisputeSettlementId" name="settlementId" value="" />

                <label for="stDisputeReasonInput" class="form-label fw-semibold small">
                    Lý do cần người chuyển kiểm tra lại <span class="text-danger">*</span>
                </label>
                <textarea id="stDisputeReasonInput" name="disputeReason" rows="3" required maxlength="500"
                          class="form-control"
                          placeholder="VD: Chưa thấy tiền vào tài khoản Vietcombank hoặc lệch số tiền..."></textarea>
                <div class="form-text small">
                    Số dư công nợ sẽ giữ nguyên cho đến khi bạn xác nhận đã nhận đủ tiền.
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn st-btn-ghost btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-danger btn-sm fw-semibold">Gửi phản hồi chưa nhận tiền</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/settlement.js" asp-append-version="true"></script>
}
