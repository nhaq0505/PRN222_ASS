@page
@model SplitTrip.Web.Pages.Trips.ItineraryModel
@{
    ViewData["Title"] = $"Lịch trình — {Model.Trip.Name}";
    var statusMeta = DetailsModel.DescribeStatus(Model.Trip.Status);
    var groupBudget = Model.Schedule.EstimatedBudgetPerPerson * Model.Schedule.ActiveMemberCount;
    var safeInitialJson = Model.InitialScheduleJson.Replace("</", "<\\/");
}

@section Styles {
    <link rel="stylesheet" href="~/css/itinerary.css" asp-append-version="true" />
}

<div id="stItineraryWorkspace"
     data-trip-id="@Model.Trip.Id"
     data-user-id="@Model.CurrentUserId"
     data-can-edit="@(Model.Schedule.CanEdit ? "true" : "false")">
    @Html.AntiForgeryToken()

    <!-- Trip Header -->
    <div class="st-card p-4 mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span id="stItinStatusBadge" class="st-status-pill @statusMeta.Css">@statusMeta.Label</span>
                    <span class="text-muted small">
                        📍 @Model.Trip.Destination &middot; @Model.Trip.StartDate.ToString("dd/MM/yyyy") &rarr; @Model.Trip.EndDate.ToString("dd/MM/yyyy") (@Model.Trip.DayCount ngày)
                    </span>
                    <span class="badge bg-light text-secondary border">
                        <span class="text-success me-1">●</span> Đồng bộ trực tiếp SignalR
                    </span>
                </div>
                <h1 class="h3 fw-bold mb-1">@Model.Trip.Name</h1>
                <p class="text-secondary small mb-0">
                    Kéo thả để sắp xếp điểm dừng giữa các ngày, bình chọn trực tiếp và dùng AI gợi ý lịch trình thông minh.
                </p>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (Model.Schedule.CanEdit)
                {
                    <button type="button" id="stOpenAiModalBtn" class="btn st-btn-ai btn-sm">
                        ✨ AI Gợi ý lịch trình
                    </button>
                    <button type="button" id="stOpenAddStopBtn" class="btn st-btn-primary btn-sm">
                        + Thêm điểm dừng
                    </button>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-secondary px-3 py-2">
                        🔒 Chế độ chỉ xem (@statusMeta.Label)
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Sub-Navigation Workspace Tabs -->
    <nav class="st-trip-tabs mb-4" aria-label="Điều hướng không gian chuyến đi">
        <a class="st-trip-tab" asp-page="/Trips/Details" asp-route-id="@Model.Trip.Id">
            Tổng quan &amp; Thành viên
        </a>
        <a class="st-trip-tab active" href="/Trips/Itinerary?tripId=@Model.Trip.Id">
            Lịch trình &amp; AI Planner
        </a>
        <a class="st-trip-tab" href="/Trips/Expenses?tripId=@Model.Trip.Id">
            Chi tiêu &amp; Quét hóa đơn
        </a>
        <a class="st-trip-tab" href="/Trips/Settlement?tripId=@Model.Trip.Id">
            Tất toán VietQR
        </a>
    </nav>

    @if (!Model.Schedule.CanEdit)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4 small">
            <strong>Chuyến đi đang ở trạng thái "@statusMeta.Label":</strong>
            Lịch trình hiện ở chế độ chỉ đọc để bảo toàn dữ liệu chuyến đi.
        </div>
    }

    <!-- KPI Summary Strip -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Tổng điểm dừng</div>
                <div class="h4 fw-bold mb-0" id="stKpiTotalStops">@Model.Schedule.TotalItemsCount điểm</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Tổng chi phí dự kiến lịch trình</div>
                <div class="h4 fw-bold mb-0 text-dark" id="stKpiTotalCost">@Model.Schedule.TotalEstimatedCost.ToString("N0")đ</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Ngân sách dự kiến cả đoàn</div>
                <div class="h4 fw-bold mb-0" id="stKpiGroupBudget">
                    @(groupBudget > 0m ? $"{groupBudget:N0}đ" : "Chưa đặt")
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3">
                <div class="small text-muted mb-1">Điểm dừng từ AI Planner</div>
                <div class="h4 fw-bold mb-0 st-link-teal" id="stKpiAiStops">@Model.Schedule.AiSuggestedItemsCount gợi ý</div>
            </div>
        </div>
    </div>

    <!-- Day Filter Tabs -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div id="stDayFilterPills" class="st-day-pills" role="tablist" aria-label="Chọn ngày xem lịch trình">
            <button type="button" class="st-day-pill active" data-filter-day="all">
                Tất cả (@Model.Schedule.Days.Count ngày)
            </button>
            @foreach (var day in Model.Schedule.Days)
            {
                <button type="button" class="st-day-pill" data-filter-day="@day.Id">
                    Ngày @day.DayNumber (@day.Date.ToString("dd/MM"))
                </button>
            }
        </div>
        <div class="small text-muted d-none d-md-block">
            💡 Nhắc khởi hành tự động gửi trước <strong>30 phút</strong> khi chuyến đi đang diễn ra.
        </div>
    </div>

    <!-- Multi-Day Collaborative Timeline -->
    <div id="stDaysTimelineContainer">
        @foreach (var day in Model.Schedule.Days)
        {
            <section class="st-day-section" data-day-section="@day.Id">
                <div class="st-day-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div class="d-flex align-items-start align-items-sm-center gap-3">
                        <span class="st-day-badge">D@(day.DayNumber)</span>
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <h2 class="h6 fw-bold mb-0">@(string.IsNullOrWhiteSpace(day.Title) ? $"Ngày {day.DayNumber}" : day.Title)</h2>
                                <span class="badge bg-light text-secondary border fw-normal">@day.Date.ToString("dd/MM/yyyy")</span>
                                <span class="small text-muted">&middot; Dự kiến: <strong>@day.DayEstimatedCost.ToString("N0")đ</strong></span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(day.Notes))
                            {
                                <div class="small text-muted mt-1">@day.Notes</div>
                            }
                        </div>
                    </div>

                    @if (Model.Schedule.CanEdit)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-sm st-btn-ghost py-1 px-2 small js-edit-day-btn"
                                    data-day-id="@day.Id">
                                ✎ Sửa ngày
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-teal st-link-teal border py-1 px-2 small js-add-stop-day-btn"
                                    data-day-id="@day.Id">
                                + Điểm dừng
                            </button>
                        </div>
                    }
                </div>

                <div class="st-day-dropzone" data-day-id="@day.Id">
                    @if (day.Items.Count == 0)
                    {
                        <div class="st-day-empty">
                            Chưa có điểm dừng nào trong Ngày @day.DayNumber. Kéo thả điểm dừng vào đây hoặc bấm <strong>+ Điểm dừng</strong>.
                        </div>
                    }
                    else
                    {
                        @for (var idx = 0; idx < day.Items.Count; idx++)
                        {
                            var item = day.Items[idx];
                            var netClass = item.NetScore > 0 ? "st-vote-net-pos"
                                : item.NetScore < 0 ? "st-vote-net-neg"
                                : "st-vote-net-zero";
                            var netText = item.NetScore > 0 ? $"+{item.NetScore}" : item.NetScore.ToString();

                            <article id="item-@item.Id"
                                     class="st-stop-card"
                                     draggable="@(Model.Schedule.CanEdit ? "true" : "false")"
                                     data-item-id="@item.Id"
                                     data-day-id="@day.Id">
                                <div class="st-drag-rail">
                                    @if (Model.Schedule.CanEdit)
                                    {
                                        <span class="st-drag-handle" title="Kéo thả để đổi thứ tự hoặc chuyển ngày">⋮⋮</span>
                                    }
                                    <span class="st-order-num">@(idx + 1)</span>
                                </div>

                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(item.StartTimeFormatted))
                                            {
                                                <span class="st-time-pill">
                                                    🕒 @item.StartTimeFormatted@(string.IsNullOrWhiteSpace(item.EndTimeFormatted) ? "" : $" – {item.EndTimeFormatted}")
                                                </span>
                                            }
                                            <h3 class="h6 fw-bold mb-0 text-dark">@item.Title</h3>
                                            @if (item.IsAiSuggested)
                                            {
                                                <span class="st-ai-badge">✨ AI gợi ý</span>
                                            }
                                            @if (item.ReminderSentAtUtc.HasValue)
                                            {
                                                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                                                    🔔 Đã nhắc khởi hành
                                                </span>
                                            }
                                        </div>

                                        <span class="st-cost-chip">
                                            @(item.EstimatedCost > 0m ? $"{item.EstimatedCost:N0}đ" : "Miễn phí")
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.LocationName) || !string.IsNullOrWhiteSpace(item.Address))
                                    {
                                        <div class="small text-secondary mb-1">
                                            📍 <strong>@(item.LocationName ?? item.Address)</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.LocationName) && !string.IsNullOrWhiteSpace(item.Address))
                                            {
                                                <span class="text-muted">&mdash; @item.Address</span>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <p class="small text-muted mb-2">@item.Notes</p>
                                    }

                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 pt-2 border-top border-light">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="st-vote-group" data-vote-box="@item.Id">
                                                <button type="button"
                                                        class="st-vote-btn js-vote-btn @(item.CurrentUserVote == VoteType.Upvote ? "st-vote-up-active" : "")"
                                                        data-item-id="@item.Id"
                                                        data-vote="1"
                                                        @(Model.Schedule.CanEdit ? "" : "disabled")
                                                        title="Tán thành điểm dừng này">
                                                    👍 <span class="js-up-count">@item.Upvotes</span>
                                                </button>
                                                <span class="st-vote-net @netClass js-net-score">@netText</span>
                                                <button type="button"
                                                        class="st-vote-btn js-vote-btn @(item.CurrentUserVote == VoteType.Downvote ? "st-vote-down-active" : "")"
                                                        data-item-id="@item.Id"
                                                        data-vote="-1"
                                                        @(Model.Schedule.CanEdit ? "" : "disabled")
                                                        title="Không tán thành điểm dừng này">
                                                    👎 <span class="js-down-count">@item.Downvotes</span>
                                                </button>
                                            </div>
                                            <span class="text-muted" style="font-size: 0.76rem;">
                                                Thêm bởi @item.CreatedByName
                                            </span>
                                        </div>

                                        @if (Model.Schedule.CanEdit)
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <button type="button"
                                                        class="btn btn-sm btn-light border py-0 px-2 small js-edit-stop-btn"
                                                        data-item-id="@item.Id">
                                                    Sửa
                                                </button>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger py-0 px-2 small js-delete-stop-btn"
                                                        data-item-id="@item.Id">
                                                    Xóa
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
            </section>
        }
    </div>
</div>

<!-- Add / Edit Stop Modal -->
<div class="modal fade" id="stStopModal" tabindex="-1" aria-labelledby="stStopModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form id="stStopForm">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="stStopModalLabel">Thêm điểm dừng lịch trình</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div id="stStopFormError" class="alert st-alert-danger py-2 px-3 small d-none"></div>
                    <input type="hidden" id="stStopItemId" value="" />

                    <div class="mb-3">
                        <label for="stStopDaySelect" class="form-label small fw-semibold">Ngày lịch trình *</label>
                        <select id="stStopDaySelect" class="form-select" required>
                            @foreach (var day in Model.Schedule.Days)
                            {
                                <option value="@day.Id">Ngày @day.DayNumber — @day.Date.ToString("dd/MM/yyyy") (@(day.Title ?? $"Ngày {day.DayNumber}"))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="stStopTitle" class="form-label small fw-semibold">Tên hoạt động / Điểm dừng *</label>
                        <input type="text" id="stStopTitle" class="form-control" maxlength="200" required
                               placeholder="VD: Săn mây Đồi chè Cầu Đất, Ăn tối hải sản..." />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="stStopStartTime" class="form-label small fw-semibold">Giờ bắt đầu</label>
                            <input type="time" id="stStopStartTime" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label for="stStopEndTime" class="form-label small fw-semibold">Giờ kết thúc</label>
                            <input type="time" id="stStopEndTime" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label for="stStopLocation" class="form-label small fw-semibold">Tên địa điểm</label>
                            <input type="text" id="stStopLocation" class="form-control" maxlength="250"
                                   placeholder="VD: Tiệm cà phê Túi Mơ To" />
                        </div>
                        <div class="col-sm-6">
                            <label for="stStopCost" class="form-label small fw-semibold">Chi phí dự kiến (VND)</label>
                            <input type="number" id="stStopCost" class="form-control" min="0" step="1000" value="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="stStopAddress" class="form-label small fw-semibold">Địa chỉ chi tiết</label>
                        <input type="text" id="stStopAddress" class="form-control" maxlength="500"
                               placeholder="Số nhà, đường, phường/xã..." />
                    </div>

                    <div class="mb-0">
                        <label for="stStopNotes" class="form-label small fw-semibold">Ghi chú cho nhóm</label>
                        <textarea id="stStopNotes" class="form-control" rows="2" maxlength="2000"
                                  placeholder="Lưu ý đặt bàn trước, trang phục, vé vào cổng..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn st-btn-ghost btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="stSaveStopBtn" class="btn st-btn-primary btn-sm">Lưu điểm dừng</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Day Modal -->
<div class="modal fade" id="stDayModal" tabindex="-1" aria-labelledby="stDayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form id="stDayForm">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="stDayModalLabel">Chỉnh sửa thông tin ngày</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div id="stDayFormError" class="alert st-alert-danger py-2 px-3 small d-none"></div>
                    <input type="hidden" id="stEditDayId" value="" />
                    <div class="mb-3">
                        <label for="stEditDayTitle" class="form-label small fw-semibold">Chủ đề / Tiêu đề ngày</label>
                        <input type="text" id="stEditDayTitle" class="form-control" maxlength="200"
                               placeholder="VD: Ngày 1: Khám phá trung tâm & Chợ đêm" />
                    </div>
                    <div class="mb-0">
                        <label for="stEditDayNotes" class="form-label small fw-semibold">Ghi chú chung trong ngày</label>
                        <textarea id="stEditDayNotes" class="form-control" rows="2" maxlength="2000"
                                  placeholder="Nhắc nhở giờ tập trung, phương tiện di chuyển..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn st-btn-ghost btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="stSaveDayBtn" class="btn st-btn-primary btn-sm">Cập nhật ngày</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- AI Trip Planner Modal -->
<div class="modal fade" id="stAiPlannerModal" tabindex="-1" aria-labelledby="stAiPlannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold" id="stAiPlannerModalLabel">
                        ✨ AI Gợi ý lịch trình — @Model.Trip.Destination (@Model.Trip.DayCount ngày)
                    </h5>
                    <div class="small text-muted">
                        Tự động thiết kế lịch trình đa ngày khớp ngân sách &amp; thời gian của nhóm bằng Gemini AI.
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div id="stAiModalError" class="alert st-alert-danger py-2 px-3 small d-none"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label for="stAiStyleSelect" class="form-label small fw-semibold">Phong cách chuyến đi</label>
                        <select id="stAiStyleSelect" class="form-select">
                            <option value="Cân bằng" selected>⚖️ Cân bằng (Tham quan + Ẩm thực + Nghỉ ngơi)</option>
                            <option value="Tiết kiệm">🎒 Tiết kiệm / Khám phá bụi</option>
                            <option value="Ẩm thực & Check-in">🍜 Ẩm thực địa phương &amp; Cafe đẹp</option>
                            <option value="Nghỉ dưỡng thoải mái">🌴 Nghỉ dưỡng thoải mái / Cao cấp</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label for="stAiBudgetInput" class="form-label small fw-semibold">Ngân sách dự kiến / người (VND)</label>
                        <input type="number" id="stAiBudgetInput" class="form-control" min="0" step="100000"
                               value="@(Model.Schedule.EstimatedBudgetPerPerson > 0m ? Model.Schedule.EstimatedBudgetPerPerson : 2500000m)" />
                    </div>
                    <div class="col-12">
                        <label for="stAiPromptInput" class="form-label small fw-semibold">Mong muốn / Ghi chú đặc biệt của nhóm</label>
                        <input type="text" id="stAiPromptInput" class="form-control" maxlength="400"
                               placeholder="VD: Ưu tiên quán ăn bản địa lâu năm, tránh leo núi quá sức, thích săn mây buổi sáng..." />
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <button type="button" id="stGenerateAiPreviewBtn" class="btn st-btn-ai btn-sm">
                        ✨ Tạo lịch trình gợi ý ngay
                    </button>
                    <div class="form-check small">
                        <input class="form-check-input" type="checkbox" id="stAiReplaceExistingCheck" />
                        <label class="form-check-label text-secondary" for="stAiReplaceExistingCheck">
                            Thay thế các điểm dừng AI gợi ý trước đó
                        </label>
                    </div>
                </div>

                <!-- Preview Output -->
                <div id="stAiPreviewWrapper" class="d-none">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span id="stAiSourceBadge" class="st-ai-badge">✨ Gemini AI</span>
                            <span id="stAiPreviewCostSummary" class="small fw-semibold text-dark"></span>
                        </div>
                        <span id="stAiFallbackHint" class="small text-muted"></span>
                    </div>
                    <div id="stAiPreviewContainer" class="st-ai-preview-box"></div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn st-btn-ghost btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" id="stApplyAiPlanBtn" class="btn st-btn-primary btn-sm" disabled>
                    ✓ Áp dụng vào lịch trình chuyến đi
                </button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="stInitialScheduleJson">@Html.Raw(safeInitialJson)</script>

@section Scripts {
    <script src="~/js/itinerary.js" asp-append-version="true"></script>
}
