@page
@using System.Text.Json
@model SplitTrip.Web.Pages.Trips.ExpensesModel
@{
    ViewData["Title"] = $"Chi tiêu — {Model.Trip.Name}";
    var statusMeta = DetailsModel.DescribeStatus(Model.Trip.Status);
    var activeCount = Math.Max(1, Model.ActiveMembers.Count);
    var avgPerMember = decimal.Floor(Model.Overview.TotalConfirmedSpend / activeCount);
    var jsonCamelOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section Styles {
    <link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />
}

<div id="stExpensesWorkspace" data-trip-id="@Model.Trip.Id">
    <!-- Trip Workspace Header -->
    <div class="st-card p-4 mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="st-status-pill @statusMeta.Css">@statusMeta.Label</span>
                    <span class="text-muted small">
                        📍 @Model.Trip.Destination &middot; @Model.Trip.StartDate.ToString("dd/MM/yyyy") &rarr; @Model.Trip.EndDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <h1 class="h3 fw-bold mb-1">@Model.Trip.Name</h1>
                <p class="text-secondary small mb-0">
                    Quản lý chi tiêu đa chế độ (Chia đều, Số tiền cụ thể, %, Shares) &amp; Quét hóa đơn AI Gemini Vision tách món trực tiếp.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                @if (Model.IsTripEditable && !Model.IsAdmin)
                {
                    <button type="button"
                            class="btn st-btn-ghost d-inline-flex align-items-center gap-2"
                            data-bs-toggle="modal"
                            data-bs-target="#stScanReceiptModal">
                        <span>✨ Quét hóa đơn AI</span>
                    </button>
                    <button type="button"
                            id="stOpenCreateExpenseBtn"
                            class="btn st-btn-primary d-inline-flex align-items-center gap-2"
                            data-bs-toggle="modal"
                            data-bs-target="#stUpsertExpenseModal">
                        <span>+ Thêm chi tiêu</span>
                    </button>
                }
                else if (!Model.IsTripEditable)
                {
                    <span class="badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                        🔒 Chuyến đi đang ở trạng thái @statusMeta.Label (Chỉ xem sổ cái)
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Sub-Navigation Workspace Tabs -->
    <nav class="st-trip-tabs mb-4" aria-label="Điều hướng không gian chuyến đi">
        <a class="st-trip-tab" asp-page="/Trips/Details" asp-route-id="@Model.Trip.Id">
            Tổng quan &amp; Thành viên
        </a>
        <a class="st-trip-tab" href="/Trips/Itinerary?tripId=@Model.Trip.Id">
            Lịch trình &amp; AI Planner
        </a>
        <a class="st-trip-tab active" href="/Trips/Expenses?tripId=@Model.Trip.Id">
            Chi tiêu &amp; Quét hóa đơn
        </a>
        <a class="st-trip-tab" href="/Trips/Settlement?tripId=@Model.Trip.Id">
            Tất toán VietQR
        </a>
    </nav>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3 h-100">
                <div class="small text-muted mb-1">Tổng chi tiêu đã xác thực</div>
                <div class="h4 fw-bold mb-1 text-dark font-monospace" id="stKpiTotalConfirmed">
                    @Model.Overview.TotalConfirmedSpend.ToString("N0")đ
                </div>
                <div class="small text-secondary" id="stKpiConfirmedCount">
                    @Model.Overview.ConfirmedExpenseCount khoản đã xác thực
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3 h-100">
                <div class="small text-muted mb-1">Bình quân / thành viên</div>
                <div class="h4 fw-bold mb-1 font-monospace" id="stKpiAvgPerMember">
                    @avgPerMember.ToString("N0")đ
                </div>
                <div class="small text-secondary">
                    Ngân sách dự kiến: @Model.Trip.EstimatedBudgetPerPerson.ToString("N0")đ
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3 h-100">
                <div class="small text-muted mb-1">Hóa đơn AI (Tách món)</div>
                <div class="h5 fw-bold mb-1 text-dark" id="stKpiAiPending">
                    @Model.Overview.OpenClaimingCount mở chọn &middot; @Model.Overview.DraftReceiptCount nháp
                </div>
                <div class="small text-secondary">
                    Phân bổ VAT &amp; giảm giá tự động
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="st-card p-3 h-100">
                <div class="small text-muted mb-1">Đối soát số nguyên VNĐ</div>
                <div class="h5 fw-bold mb-1 text-success">
                    ✓ Khớp 100% (0đ sai số)
                </div>
                <div class="small text-secondary">
                    Đồng bộ trực tiếp qua SignalR
                </div>
            </div>
        </div>
    </div>

    <!-- Category Filter Bar -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <a href="/Trips/Expenses?tripId=@Model.Trip.Id"
           class="st-cat-pill @(Model.SelectedCategory is null ? "active" : "")">
            <span>Tất cả</span>
        </a>
        @foreach (var cat in Enum.GetValues<ExpenseCategory>())
        {
            var (catLabel, catIcon) = ExpensesModel.DescribeCategory(cat);
            var catSpend = Model.Overview.SpendByCategory.GetValueOrDefault(cat, 0m);
            <a href="/Trips/Expenses?tripId=@Model.Trip.Id&category=@cat"
               class="st-cat-pill @(Model.SelectedCategory == cat ? "active" : "")">
                <span>@catIcon</span>
                <span>@catLabel</span>
                @if (catSpend > 0m)
                {
                    <span class="opacity-75 font-monospace small">(@(decimal.Floor(catSpend / 1000m).ToString("N0"))k)</span>
                }
            </a>
        }
    </div>

    <!-- Expenses Feed Container (Live Synced) -->
    <div id="stExpensesFeedContainer">
        @if (Model.Overview.Expenses.Count == 0)
        {
            <div class="st-card p-5 text-center">
                <div class="display-6 mb-2">🧾</div>
                <h2 class="h5 fw-bold mb-2">Chưa có khoản chi tiêu nào@(Model.SelectedCategory.HasValue ? " trong danh mục này" : "")</h2>
                <p class="text-secondary small mb-4">
                    Hãy bấm <strong>+ Thêm chi tiêu</strong> để chia tiền nhanh theo 4 chế độ hoặc <strong>✨ Quét hóa đơn AI</strong> để cả đoàn cùng tick chọn món ăn trực tiếp!
                </p>
                @if (Model.IsTripEditable && !Model.IsAdmin)
                {
                    <div class="d-flex justify-content-center flex-wrap gap-2">
                        <button type="button" class="btn st-btn-ghost" data-bs-toggle="modal" data-bs-target="#stScanReceiptModal">
                            ✨ Thử Quét hóa đơn AI
                        </button>
                        <button type="button" class="btn st-btn-primary" data-bs-toggle="modal" data-bs-target="#stUpsertExpenseModal">
                            + Thêm khoản chi đầu tiên
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var exp in Model.Overview.Expenses)
                {
                    var (catLabel, catIcon) = ExpensesModel.DescribeCategory(exp.Category);
                    var canManage = Model.IsTripEditable && (exp.PaidByUserId == Model.CurrentUserId || Model.IsOwner);
                    var cardExtraCss = exp.ScanStatus == ReceiptScanStatus.DraftReview ? "st-expense-card-draft"
                        : exp.ScanStatus == ReceiptScanStatus.ClaimingOpen ? "st-expense-card-claiming"
                        : "";

                    var editJson = exp.ScanStatus == ReceiptScanStatus.None && exp.SplitMode != ExpenseSplitMode.Itemized
                        ? JsonSerializer.Serialize(new
                        {
                            id = exp.Id,
                            title = exp.Title,
                            category = exp.Category.ToString(),
                            paidByUserId = exp.PaidByUserId,
                            totalAmount = exp.TotalAmount,
                            splitMode = exp.SplitMode.ToString(),
                            notes = exp.Notes,
                            splits = exp.Splits.Select(s => new
                            {
                                userId = s.UserId,
                                shareRatioOrWeight = s.ShareRatioOrWeight,
                                owedAmount = s.OwedAmount
                            })
                        }, jsonCamelOptions)
                        : null;

                    <div class="st-expense-card @cardExtraCss">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                            <div class="d-flex align-items-start gap-3">
                                <span class="st-cat-icon" aria-hidden="true">@catIcon</span>
                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <h3 class="h6 fw-bold mb-0 text-dark">@exp.Title</h3>
                                        <span class="badge rounded-pill bg-light text-secondary border">@catLabel</span>
                                        <span class="badge rounded-pill bg-light text-dark border">@ExpensesModel.DescribeSplitMode(exp.SplitMode)</span>

                                        @if (exp.ScanStatus == ReceiptScanStatus.DraftReview)
                                        {
                                            <span class="badge rounded-pill text-bg-warning">📝 Chờ duyệt nháp OCR (Chưa tính vào công nợ)</span>
                                        }
                                        else if (exp.ScanStatus == ReceiptScanStatus.ClaimingOpen)
                                        {
                                            <span class="badge rounded-pill text-bg-primary">
                                                🟢 Đang mở chọn món Live @(exp.UnclaimedItemCount > 0 ? $"(còn {exp.UnclaimedItemCount}/{exp.ReceiptItemCount} món trống)" : "(đủ món)")
                                            </span>
                                        }
                                        else if (exp.ScanStatus == ReceiptScanStatus.Locked)
                                        {
                                            <span class="badge rounded-pill text-bg-success">🔒 Đã khóa tách món (@exp.ReceiptItemCount món)</span>
                                        }
                                    </div>

                                    <div class="small text-muted mb-2">
                                        Người ứng trả: <strong class="text-dark">@exp.PaidByName</strong>
                                        &middot; @exp.SpentAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (exp.TaxOrTipAmount > 0m || exp.DiscountAmount > 0m)
                                        {
                                            <span>
                                                &middot; Tạm tính @exp.SubtotalAmount.ToString("N0")đ
                                                @if (exp.TaxOrTipAmount > 0m) { <text> + VAT/Phí @exp.TaxOrTipAmount.ToString("N0")đ</text> }
                                                @if (exp.DiscountAmount > 0m) { <text> - Giảm @exp.DiscountAmount.ToString("N0")đ</text> }
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(exp.Notes))
                                    {
                                        <div class="small text-secondary mb-2">@exp.Notes</div>
                                    }

                                    @if (exp.ScanStatus != ReceiptScanStatus.DraftReview && exp.Splits.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            @foreach (var s in exp.Splits)
                                            {
                                                <span class="st-split-chip">
                                                    <span>@(s.UserId == Model.CurrentUserId ? "Bạn" : s.FullName):</span>
                                                    <span class="st-split-chip-amount">@s.OwedAmount.ToString("N0")đ</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="d-flex flex-md-column align-items-md-end justify-content-between gap-2 flex-shrink-0">
                                <div class="h5 fw-bold font-monospace mb-0 text-dark">
                                    @exp.TotalAmount.ToString("N0")đ
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    @if (exp.ScanStatus == ReceiptScanStatus.DraftReview)
                                    {
                                        <a href="/Trips/ReceiptClaim?tripId=@Model.Trip.Id&expenseId=@exp.Id"
                                           class="btn btn-sm btn-warning fw-semibold">
                                            Duyệt nháp OCR &rarr;
                                        </a>
                                    }
                                    else if (exp.ScanStatus == ReceiptScanStatus.ClaimingOpen)
                                    {
                                        <a href="/Trips/ReceiptClaim?tripId=@Model.Trip.Id&expenseId=@exp.Id"
                                           class="btn btn-sm st-btn-primary py-1 px-3">
                                            Vào chọn món Live &rarr;
                                        </a>
                                    }
                                    else if (exp.ScanStatus == ReceiptScanStatus.Locked)
                                    {
                                        <a href="/Trips/ReceiptClaim?tripId=@Model.Trip.Id&expenseId=@exp.Id"
                                           class="btn btn-sm st-btn-ghost py-1 px-3">
                                            Xem bảng tách món
                                        </a>
                                    }

                                    @if (canManage && editJson is not null)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-edit-expense="@editJson">
                                            Sửa
                                        </button>
                                    }

                                    @if (canManage)
                                    {
                                        <form method="post" asp-page-handler="DeleteExpense" class="d-inline m-0"
                                              onsubmit="return confirm('Xóa khoản chi tiêu này khỏi sổ cái chuyến đi?');">
                                            <input type="hidden" name="tripId" value="@Model.Trip.Id" />
                                            <input type="hidden" name="expenseId" value="@exp.Id" />
                                            <input type="hidden" name="returnCategory" value="@Model.SelectedCategory" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Xóa
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (Model.IsTripEditable && !Model.IsAdmin)
{
    <!-- Multi-Mode Create / Edit Expense Modal -->
    <div class="modal fade" id="stUpsertExpenseModal" tabindex="-1" aria-labelledby="stUpsertModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 18px;">
                <form method="post" asp-page-handler="SaveExpense" id="stUpsertExpenseForm">
                    <div class="modal-header border-bottom px-4 py-3">
                        <h2 class="modal-title h5 fw-bold mb-0" id="stUpsertModalTitle">Thêm khoản chi tiêu mới</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>

                    <div class="modal-body p-4">
                        <input type="hidden" name="TripId" value="@Model.Trip.Id" />
                        <input type="hidden" name="ExpenseId" id="stFormExpenseId" value="" />
                        <input type="hidden" name="ReturnCategory" value="@Model.SelectedCategory" />
                        <input type="hidden" name="SplitMode" id="stFormSplitMode" value="Equal" />

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-7">
                                <label for="stFormTitle" class="form-label small fw-semibold">Tên khoản chi tiêu <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="stFormTitle" name="Title"
                                       maxlength="200" placeholder="VD: Vé cáp treo Fansipan, Taxi sân bay..." required />
                            </div>
                            <div class="col-12 col-md-5">
                                <label for="stFormCategory" class="form-label small fw-semibold">Danh mục</label>
                                <select class="form-select" id="stFormCategory" name="Category">
                                    @foreach (var cat in Enum.GetValues<ExpenseCategory>())
                                    {
                                        var (catLabel, catIcon) = ExpensesModel.DescribeCategory(cat);
                                        <option value="@cat">@catIcon @catLabel</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label for="stFormTotalAmount" class="form-label small fw-semibold">Tổng số tiền (VNĐ nguyên) <span class="text-danger">*</span></label>
                                <input type="number" min="1" step="1" class="form-control font-monospace fw-bold"
                                       id="stFormTotalAmount" name="TotalAmount" placeholder="VD: 350000" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label for="stFormPaidBy" class="form-label small fw-semibold">Người đã ứng trả bill</label>
                                <select class="form-select" id="stFormPaidBy" name="PaidByUserId">
                                    @foreach (var m in Model.ActiveMembers)
                                    {
                                        if (m.UserId == Model.CurrentUserId)
                                        {
                                            <option value="@m.UserId" selected>@m.FullName (Bạn)</option>
                                        }
                                        else
                                        {
                                            <option value="@m.UserId">@m.FullName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- 4 Manual Split Modes Switcher -->
                        <div class="mb-2">
                            <label class="form-label small fw-semibold d-block">Chế độ chia tiền</label>
                            <div class="st-mode-tabs" role="tablist">
                                <button type="button" class="st-mode-tab-btn active" data-split-mode-btn="Equal">Chia đều</button>
                                <button type="button" class="st-mode-tab-btn" data-split-mode-btn="ExactAmount">Số tiền cụ thể</button>
                                <button type="button" class="st-mode-tab-btn" data-split-mode-btn="Percentage">Theo tỷ lệ %</button>
                                <button type="button" class="st-mode-tab-btn" data-split-mode-btn="Shares">Theo phần (Shares)</button>
                            </div>
                            <div id="stSplitModeHint" class="form-text small text-muted mt-1"></div>
                        </div>

                        <!-- Live Participant Split Rows -->
                        <div class="d-flex flex-column gap-2 my-3">
                            @for (var i = 0; i < Model.ActiveMembers.Count; i++)
                            {
                                var member = Model.ActiveMembers[i];
                                <div class="st-participant-row" data-participant-row data-user-id="@member.UserId">
                                    <div class="form-check d-flex align-items-center gap-2 m-0">
                                        <input type="hidden" name="Participants[@i].UserId" value="@member.UserId" />
                                        <input class="form-check-input mt-0" type="checkbox"
                                               id="stPartCheck_@i"
                                               name="Participants[@i].Selected"
                                               value="true"
                                               data-participant-check
                                               checked />
                                        <label class="form-check-label fw-semibold text-dark small" for="stPartCheck_@i">
                                            @member.FullName
                                            @if (member.UserId == Model.CurrentUserId)
                                            {
                                                <span class="text-muted fw-normal">(Bạn)</span>
                                            }
                                        </label>
                                    </div>

                                    <div class="d-flex align-items-center gap-3">
                                        <div class="input-group input-group-sm d-none" style="width: 155px;" data-participant-input-wrap>
                                            <input type="number" class="form-control text-end font-monospace"
                                                   name="Participants[@i].Value"
                                                   value="1"
                                                   data-participant-val />
                                            <span class="input-group-text small" data-participant-unit>phần</span>
                                        </div>
                                        <div class="text-end font-monospace fw-bold text-dark" style="min-width: 95px;" data-participant-owed>
                                            0đ
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div id="stSplitPreviewStatus" class="small px-3 py-2 rounded-3 st-alert-danger mb-3">
                            Nhập tổng chi tiêu nguyên dương (VNĐ) để xem trước phần chia.
                        </div>

                        <div>
                            <label for="stFormNotes" class="form-label small fw-semibold">Ghi chú (tùy chọn)</label>
                            <input type="text" class="form-control" id="stFormNotes" name="Notes"
                                   maxlength="500" placeholder="VD: Đã gồm phí cầu đường..." />
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3">
                        <button type="button" class="btn st-btn-ghost" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="stSaveExpenseSubmitBtn" class="btn st-btn-primary">
                            Lưu khoản chi tiêu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- AI Receipt Scanner Upload Modal -->
    <div class="modal fade" id="stScanReceiptModal" tabindex="-1" aria-labelledby="stScanModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 18px;">
                <form method="post" asp-page-handler="ScanReceipt" enctype="multipart/form-data">
                    <div class="modal-header border-bottom px-4 py-3">
                        <h2 class="modal-title h5 fw-bold mb-0" id="stScanModalLabel">✨ Quét hóa đơn AI (Gemini Vision)</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>

                    <div class="modal-body p-4">
                        <input type="hidden" name="tripId" value="@Model.Trip.Id" />

                        <p class="small text-secondary mb-3">
                            Tải ảnh hóa đơn ăn uống / mua sắm để AI tự động bóc tách từng món, thuế VAT và giảm giá. Sau khi duyệt nháp, cả đoàn sẽ cùng tick chọn món trực tiếp qua SignalR!
                        </p>

                        <div class="mb-3" id="stReceiptFileInputWrap">
                            <label for="stReceiptImageInput" class="form-label small fw-semibold">Ảnh chụp hóa đơn (JPG, PNG, WEBP &le; 10 MB)</label>
                            <input type="file" class="form-control" id="stReceiptImageInput" name="receiptImage"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                        </div>

                        <div class="p-3 rounded-3 bg-light border mb-3">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="stUseDemoSampleSwitch" name="useDemoSample" value="true" />
                                <label class="form-check-label small fw-semibold text-dark" for="stUseDemoSampleSwitch">
                                    Dùng hóa đơn mẫu Demo AI (Lẩu &amp; Nướng Đà Lạt + VAT 8% + Voucher)
                                </label>
                            </div>
                            <div class="small text-muted mt-1" style="font-size: 0.78rem;">
                                Tiện lợi khi thuyết trình / kiểm thử nhanh mà không cần chụp ảnh hoặc cấu hình API Key.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="stScanPaidBy" class="form-label small fw-semibold">Người đã thanh toán hóa đơn</label>
                            <select class="form-select" id="stScanPaidBy" name="paidByUserId">
                                @foreach (var m in Model.ActiveMembers)
                                {
                                    if (m.UserId == Model.CurrentUserId)
                                    {
                                        <option value="@m.UserId" selected>@m.FullName (Bạn)</option>
                                    }
                                    else
                                    {
                                        <option value="@m.UserId">@m.FullName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div>
                            <label for="stScanNotes" class="form-label small fw-semibold">Ghi chú thêm (tùy chọn)</label>
                            <input type="text" class="form-control" id="stScanNotes" name="notes"
                                   maxlength="300" placeholder="VD: Bữa tối liên hoan cả đoàn..." />
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3">
                        <button type="button" class="btn st-btn-ghost" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn st-btn-primary">
                            Phân tích hóa đơn &rarr;
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/expenses.js" asp-append-version="true"></script>
}
