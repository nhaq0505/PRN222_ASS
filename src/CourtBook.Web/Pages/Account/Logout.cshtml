@page
@model CourtBook.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="cb-auth-wrap">
    <div class="cb-auth-card cb-auth-card--center">
        <h1 class="cb-auth-title">Đăng xuất khỏi CourtBook</h1>
        <p class="cb-auth-subtitle">Nhấn nút bên dưới để kết thúc phiên làm việc hiện tại.</p>
        <form method="post">
            <button type="submit" class="cb-btn cb-btn--primary cb-btn--block">Xác nhận đăng xuất</button>
        </form>
    </div>
</div>
