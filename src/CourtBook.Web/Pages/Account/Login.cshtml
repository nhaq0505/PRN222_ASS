@page
@model CourtBook.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="cb-auth-wrap">
    <div class="cb-auth-card cb-auth-card--wide">
        <div class="cb-auth-header">
            <h1 class="cb-auth-title">Đăng nhập CourtBook</h1>
            <p class="cb-auth-subtitle">Khám phá nhiều cụm sân đối tác, giữ chỗ &amp; quản lý lịch theo thời gian thực.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="cb-validation-summary"></div>

        <form method="post" class="cb-auth-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="cb-field">
                <label asp-for="Input.Email" class="cb-field__label">Email</label>
                <input asp-for="Input.Email" class="cb-input" type="email" autocomplete="email" placeholder="ten@example.com" />
                <span asp-validation-for="Input.Email" class="cb-field-error"></span>
            </div>

            <div class="cb-field">
                <label asp-for="Input.Password" class="cb-field__label">Mật khẩu</label>
                <input asp-for="Input.Password" class="cb-input" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Input.Password" class="cb-field-error"></span>
            </div>

            <button type="submit" class="cb-btn cb-btn--primary cb-btn--block">Đăng nhập</button>
        </form>

        @if (Model.DemoAccounts.Count > 0)
        {
            <div class="cb-divider"><span>hoặc</span></div>

            <div class="cb-demo-section">
                <div class="cb-demo-header">
                    <h2 class="cb-demo-title">Đăng nhập nhanh 1 chạm (Demo Multi-Owner)</h2>
                    <p class="cb-demo-subtitle">Chuyển nhanh giữa Khách đặt sân, Chủ sân Khôi / Hà và Quản trị sàn.</p>
                </div>
                <div class="cb-demo-groups">
                    @foreach (IGrouping<string, DemoAccountDto> group in Model.DemoAccounts
                        .GroupBy(d => ResolveGroupKey(d.Group))
                        .OrderBy(g => ResolveGroupOrder(g.Key)))
                    {
                        string badgeClass = ResolveDemoBadgeClass(group.Key);
                        <div class="cb-demo-group">
                            <div class="cb-demo-group__label">@ResolveGroupTitle(group.Key)</div>
                            <div class="cb-demo-grid @(group.Count() == 1 ? "cb-demo-grid--single" : "")">
                                @foreach (DemoAccountDto demo in group)
                                {
                                    <form method="post" asp-page-handler="DemoLogin">
                                        <input type="hidden" name="email" value="@demo.Email" />
                                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                        <button type="submit" class="cb-demo-btn">
                                            <span class="cb-demo-btn__top">
                                                <span class="cb-demo-btn__name">@demo.Label</span>
                                                <span class="cb-badge @badgeClass">@demo.RoleBadge</span>
                                            </span>
                                            <span class="cb-demo-btn__email">@demo.Email</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="cb-auth-footer">
            <span>Chưa có tài khoản?</span>
            <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl" class="cb-link">Đăng ký hội viên</a>
            <span class="cb-auth-footer__sep">·</span>
            <a asp-page="/Account/Register" asp-route-owner="true" class="cb-link">Mở sân hợp tác</a>
        </div>
    </div>
</div>

@functions {
    private static string ResolveGroupKey(string? group) => (group ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "member" or "khách đặt sân" => "Member",
        "owner" or "courtowner" or "chủ cụm sân" => "Owner",
        "admin" or "quản trị sàn" => "Admin",
        _ => string.IsNullOrWhiteSpace(group) ? "Member" : group.Trim()
    };

    private static string ResolveGroupTitle(string groupKey) => groupKey switch
    {
        "Member" => "Khách đặt sân",
        "Owner" => "Chủ cụm sân",
        "Admin" => "Quản trị sàn",
        _ => groupKey
    };

    private static int ResolveGroupOrder(string groupKey) => groupKey switch
    {
        "Member" => 1,
        "Owner" => 2,
        "Admin" => 3,
        _ => 4
    };

    private static string ResolveDemoBadgeClass(string groupKey) => groupKey switch
    {
        "Admin" => "cb-badge--admin",
        "Owner" => "cb-badge--owner",
        _ => "cb-badge--member"
    };
}
